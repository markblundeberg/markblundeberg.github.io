{% set idprefix = "esbd-ss-quasifermi" %}
{% import "macros/controls.njk" as controls %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 280px"></div>
{{ controls.slider(idprefix + "-light", "Illumination (peak splitting)", { min: 0, max: 0.8, step: "any", value: 0.4, snap: 0, readout: true, unit: "V" }) }}

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, linspace } from '{{ esbdJsPath }}utils.js';

    // Uniformly illuminated bar between two plain metal contacts, no bias.
    // Photogeneration runs recombination in reverse (∅ → e⁻ + h⁺), splitting
    // the rails; each metal face is a perfect recombination surface that pins
    // V_e- = V_h+ there, so the split is a lens: the classic cosh profile for
    // uniform generation with diffusion length L and absorbing boundaries.
    // Drawn symmetric (equal split, equal conductivities), which makes the two
    // species currents cancel exactly at every x: zero net charge current,
    // two closed conventional-current loops (pumped up mid-bar, falling back
    // down at the contacts). Band edges deliberately omitted; this figure is
    // about the rails.
    const L = 0.18; // diffusion length, in x units
    const MID = 0.5; // equilibrium Fermi level (arbitrary height)
    const XL = 0.15,
        XR = 0.85; // semiconductor extent
    const XM = (XL + XR) / 2;
    const CH = Math.cosh((XR - XL) / 2 / L);

    const diagram = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-container',
        {
            electron: SPECIES.electron,
            hole: SPECIES.hole,
        },
        { margins: { right: 70 } } // fits the merged V_e- = V_h+ label
    );
    diagram.setSpatialLayout([0, XL, XR, 1], [
        { ...REGION.metal, name: 'Metal' },
        REGION.semiconductor,
        { ...REGION.metal, name: 'Metal' },
    ]);
    diagram.setVRange(0.0, 1.0);

    const xh = linspace(XL, XR, 61);
    const xe = linspace(0, 1, 121); // electron trace runs into both metals

    function update(b) {
        document.getElementById('{{idprefix}}-light-readout').textContent =
            b.toFixed(2);
        const merged = b < 0.05; // label-merge threshold (display only)

        // rail splitting: peak b at mid-bar, zero at the metal faces
        const split = (x) =>
            x <= XL || x >= XR
                ? 0
                : (b * (1 - Math.cosh((x - XM) / L) / CH)) / (1 - 1 / CH);
        const vh = (x) => MID + split(x) / 2;
        const ve = (x) => MID - split(x) / 2;

        diagram.updateTraceData([
            {
                id: 'vh',
                speciesId: 'hole',
                curveType: 'voltage',
                showLabel: !merged,
                labelFrac: 0.18,
                x: xh,
                y: xh.map(vh),
            },
            {
                id: 've',
                speciesId: 'electron',
                curveType: 'voltage',
                label: merged
                    ? 'V_{\\mathrm{e}^-}{=}V_{\\mathrm{h}^+}'
                    : 'V_{\\mathrm{e}^-}',
                x: xe,
                y: xe.map(ve),
            },
        ]);

        // photogeneration pumps: bare current arrows pointing UP, low rail to
        // high rail (recombination run backwards, so the reverse of the LED
        // figure convention); they collapse with the split as the light dims.
        // The metal faces keep an always-equilibrated ⇌ (zero-height marker:
        // the rails coincide there, and that coincidence is the equilibrium).
        diagram.updateVerticalMarkers([
            ...[0.35, 0.5, 0.65].map((x, i) => ({
                id: 'gen' + i,
                x,
                yDefs: [{ y: ve(x) }],
                symbol: null,
                driven: { y: vh(x), color: '#666', pump: true },
                popupCallback: () =>
                    '$\\varnothing \\rightarrow \\mathrm{e}^- + \\mathrm{h}^+$ — net photogeneration; the arrow is the conventional current pumped between the rails',
            })),
            ...[XL, XR].map((x, i) => ({
                id: 'contact' + i,
                x,
                yDefs: [{ y: MID }],
                symbol: '⇌',
                popupCallback: () =>
                    '$\\mathrm{e}^- + \\mathrm{h}^+ \\rightleftharpoons \\varnothing$ — the metal face is a perfect recombination surface, pinning the rails together',
            })),
        ]);
    }

    makeSlider('{{idprefix}}-light', update);
</script>
