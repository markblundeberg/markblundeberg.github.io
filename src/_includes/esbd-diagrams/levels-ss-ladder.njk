{% set idprefix = "levels-ss-ladder" %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 300px"></div>

<script type="module">
    import EnergyLevelsDiagram from '{{ esbdJsPath }}EnergyLevelsDiagram.js';
    import { SPECIES } from '{{ esbdJsPath }}figureDefs.js';

    // Left band: acidified nitrate/chloride solution. V°_i from iondata.txt
    // (H⁺ 0, NO₃⁻ +1.127, Cl⁻ +1.360 V), chosen so the rung span (~1.4 V) is
    // comparable to silicon's gap — no compressed not-to-scale rungs needed.
    // Concentrations (drawn as gap arrows, mirroring the n/p arrows): pH 4,
    // 10 mM NO₃⁻, 10 mM Cl⁻ (spectator cation not drawn).
    // Right band: Si edges 1.12 V apart, N_C = 2.8e19, N_V = 1.04e19 cm⁻³;
    // slider sets n, and p follows from n·p = N_C·N_V·10^(−Eg/decade)
    // (log₁₀ n·p = 19.53, i.e. n_i ≈ 5.8e9 cm⁻³). The band alignment between
    // the two columns is arbitrary (nothing is in contact).
    const DEC = 0.05916;
    const V0_H = 0,
        V0_NO3 = 1.127,
        V0_CL = 1.36;
    const V_H = V0_H + DEC * -4;
    const V_NO3 = V0_NO3 + DEC * 2;
    const V_CL = V0_CL + DEC * 2;
    const V0E = 0.05, // conduction edge (electron standard state)
        V0H = V0E + 1.12; // valence edge (hole standard state)
    const LOG_NC = 19.447,
        LOG_NV = 19.017;

    const BLUE = SPECIES.electron.color;
    const EDGE = { lineWidth: 2, dasharray: '4,2' }; // band-edge style
    const RUNG = { lineWidth: 1 };
    const CARRIER = { lineWidth: 3 };

    const diagram = new EnergyLevelsDiagram('{{idprefix}}-container', {
        yAxisLabel: 'Voltage (V) - arbitrary offset',
        yRange: [-0.42, 1.72],
        categories: [
            { id: 'soln', label: 'Solution' },
            { id: 'semi', label: 'Semiconductor' },
        ],
        bandMinPaddingOuter: { left: 48, right: 42 },
        bandMinPaddingInner: 80, // V_e- = V_h+ label hangs left of the semi band
    });

    function update(logn) {
        const VF = V0E + DEC * (LOG_NC - logn); // Fermi level, from the n side
        const logp = LOG_NV - (V0H - VF) / DEC; // consistent: logn+logp = LOG_NP

        diagram.setLevels([
            {
                categoryId: 'soln',
                levelId: 'r_h',
                yValue: V0_H,
                label: 'V^\\circ_{\\mathrm{H}^+}',
                color: SPECIES.proton.color,
                style: RUNG,
                hatch: { z: 1 },
                labelSide: 'left',
            },
            {
                categoryId: 'soln',
                levelId: 'r_no3',
                yValue: V0_NO3,
                label: 'V^\\circ_{\\mathrm{NO_3}^-}',
                color: SPECIES.nitrate.color,
                style: RUNG,
                hatch: { z: -1 },
                labelSide: 'left',
            },
            {
                categoryId: 'soln',
                levelId: 'r_cl',
                yValue: V0_CL,
                label: 'V^\\circ_{\\mathrm{Cl}^-}',
                color: SPECIES.chloride.color,
                style: RUNG,
                hatch: { z: -1 },
                labelSide: 'left',
            },
            {
                categoryId: 'soln',
                levelId: 'v_h',
                yValue: V_H,
                label: 'V_{\\mathrm{H}^+}',
                color: SPECIES.proton.color,
                style: CARRIER,
            },
            {
                categoryId: 'soln',
                levelId: 'v_no3',
                yValue: V_NO3,
                label: 'V_{\\mathrm{NO_3}^-}',
                color: SPECIES.nitrate.color,
                style: CARRIER,
            },
            {
                categoryId: 'soln',
                levelId: 'v_cl',
                yValue: V_CL,
                label: 'V_{\\mathrm{Cl}^-}',
                color: SPECIES.chloride.color,
                style: CARRIER,
            },
            {
                categoryId: 'semi',
                levelId: 'edge_e',
                yValue: V0E,
                label: 'V^\\circ_{\\mathrm{e}^-}',
                color: BLUE,
                style: EDGE,
                hatch: { z: -1 }, // into the conduction band
            },
            {
                categoryId: 'semi',
                levelId: 'edge_h',
                yValue: V0H,
                label: 'V^\\circ_{\\mathrm{h}^+}',
                color: SPECIES.hole.color,
                style: EDGE,
                hatch: { z: 1 }, // into the valence band
            },
            {
                categoryId: 'semi',
                levelId: 'fermi',
                yValue: VF,
                label: 'V_{\\mathrm{e}^-}{=}V_{\\mathrm{h}^+}',
                color: BLUE,
                style: CARRIER,
                labelSide: 'left',
            },
        ]);

        diagram.setArrows([
            {
                arrowId: 'c_h',
                fromLevelId: 'r_h',
                toLevelId: 'v_h',
                label: 'c = 10^{-4}\\,\\mathrm{mol/L}',
                arrowStyle: '<->',
                dxFrac: -0.12,
            },
            {
                arrowId: 'c_no3',
                fromLevelId: 'r_no3',
                toLevelId: 'v_no3',
                label: 'c = 10^{-2}\\,\\mathrm{mol/L}',
                arrowStyle: '<->',
                dxFrac: -0.12,
            },
            {
                arrowId: 'c_cl',
                fromLevelId: 'r_cl',
                toLevelId: 'v_cl',
                label: 'c = 10^{-2}\\,\\mathrm{mol/L}',
                arrowStyle: '<->',
                dxFrac: -0.12,
            },
            {
                arrowId: 'n',
                fromLevelId: 'edge_e',
                toLevelId: 'fermi',
                label: `n = 10^{${logn.toFixed(1)}}\\,\\mathrm{cm^{-3}}`,
                arrowStyle: '<->',
                dxFrac: -0.24,
            },
            {
                arrowId: 'p',
                fromLevelId: 'edge_h',
                toLevelId: 'fermi',
                label: `p = 10^{${logp.toFixed(1)}}\\,\\mathrm{cm^{-3}}`,
                arrowStyle: '<->',
                dxFrac: 0.24,
                labelHAlign: 'right',
            },
        ]);
    }

    // Static: a fixed representative n-type doping (n = 10^16 cm^-3). The
    // interactive electron-density solve now lives in the Charge neutrality topic
    // (levels-cc-dopant); here the point is only the two-ladder analogy.
    update(16);
</script>
