{% set idprefix = "esbd-es-blips" %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 260px"></div>
<div class="bd-container" id="{{idprefix}}-rho" style="height: 110px"></div>

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import XYPlot from '{{ esbdJsPath }}XYPlot.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { linspace } from '{{ esbdJsPath }}utils.js';

    // Static: the honest picture of a bulk solution between a metal and
    // vacuum. Everything is flat except tiny double-layer blips of V°_i
    // within a few Debye lengths of each surface — which we normally don't
    // bother to draw. V_i ride flat over the blips. phi_vac drawn only in
    // the vacuum (it's screened away inside conductors).
    // Rung spacing compressed: anchoring Na+ as drawn-true, the Cl- pair
    // sits 0.22 - (0.78 + 4.075) ≈ -4.63 V from its IUPAC-referenced
    // position (true V°_Cl - V°_Na = +4.075 V).
    const CL_SHIFT = -4.63;
    const diagram = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-container',
        {
            electron: SPECIES.electron,
            cation: SPECIES.sodium,
            anion: SPECIES.chloride,
        },
        { margins: { right: 56 } }
    );
    diagram.setSpatialLayout([0, 0.22, 0.78, 1], [
        REGION.metal,
        REGION.solution,
        REGION.vacuum,
    ]);
    diagram.setVRange(-0.05, 1.3);

    const xs = linspace(0.22, 0.78, 121);
    const LAM = 0.012; // Debye length, tiny vs the vessel
    const blip = (x, aL, aR) =>
        aL * Math.exp(-(x - 0.22) / LAM) + aR * Math.exp(-(0.78 - x) / LAM);

    diagram.updateTraceData([
        {
            id: 've',
            speciesId: 'electron',
            curveType: 'voltage',
            x: [0, 0.22],
            y: [0.55, 0.55],
        },
        {
            id: 'vna',
            speciesId: 'cation',
            curveType: 'voltage',
            x: [0.22, 0.78],
            y: [0.62, 0.62],
        },
        {
            id: 'vcl',
            speciesId: 'anion',
            curveType: 'voltage',
            refShift: CL_SHIFT,
            x: [0.22, 0.78],
            y: [0.38, 0.38],
        },
        {
            id: 'vna0',
            speciesId: 'cation',
            curveType: 'standardState',
            x: xs,
            y: xs.map((x) => 0.78 + blip(x, -0.13, 0.09)),
        },
        {
            id: 'vcl0',
            speciesId: 'anion',
            curveType: 'standardState',
            refShift: CL_SHIFT,
            x: xs,
            y: xs.map((x) => 0.22 + blip(x, -0.13, 0.09)),
        },
        {
            // Work-function canon (2026-07-10): the step down from a metal's
            // V_e- to phi_vac may be compressed (real Phi/e is 4-5 V) but
            // never reordered — phi_vac stays BELOW V_e-. Drawn 0.45 V below
            // the metal line, in the clear zone under the ladder (0.3 sat
            // confusingly flush with the Cl rung's wall blip);
            // disclosed in the caption. The old y=1.15 sat ABOVE the metal's
            // V_e-, which read as a negative work function.
            id: 'phivac',
            speciesId: 'electron',
            curveType: 'phi',
            label: '\\phi_{\\mathrm{vac}}',
            x: [0.78, 1],
            y: [0.1, 0.1],
        },
    ]);

    // charge panel: each wall hides a double layer — a surface sheet and
    // its diffuse answer in the solution, equal and opposite, a few Debye
    // lengths wide. Zero everywhere else: THAT is quasi-neutrality.
    // Left wall (metal): blip dips -0.13 -> positive diffuse charge in the
    // solution, negative sheet on the metal surface. Right wall (vacuum):
    // blip +0.09, mirrored and weaker. Sheet/lobe areas match per wall
    // (0.63·0.008·sqrt(pi) ≈ 0.75·0.012).
    const rho = new XYPlot('{{idprefix}}-rho', {
        xLabel: '',
        yLabel: 'Charge density',
        xRange: [0, 1],
        yRange: [-1.0, 1.0],
        xMode: 'abstract',
        yMode: 'abstract',
        // left/right match the band diagram above so the walls line up
        margins: { top: 4, bottom: 12, left: 60, right: 56 },
    });
    const xr = linspace(0, 1, 401);
    const R = 0.09 / 0.13; // the right wall's blip is weaker
    const sheet = (x, x0) => Math.exp(-(((x - x0) / 0.008) ** 2));
    const lobeL = (x) => (x < 0.22 ? 0 : Math.exp(-(x - 0.22) / LAM));
    const lobeR = (x) => (x > 0.78 ? 0 : Math.exp(-(0.78 - x) / LAM));
    rho.updateTraceData([
        {
            id: 'zero',
            x: [0, 1],
            y: [0, 0],
            color: '#bbb',
            style: { lineWidth: 1 },
            showLabel: false,
        },
        {
            id: 'sheets',
            x: [...xr],
            y: xr.map((x) => -0.63 * sheet(x, 0.213) + 0.63 * R * sheet(x, 0.787)),
            color: '#555',
            style: { lineWidth: 1.5 },
            showLabel: false,
        },
        {
            id: 'lobes',
            x: [...xr],
            y: xr.map((x) => 0.75 * lobeL(x) - 0.75 * R * lobeR(x)),
            color: '#7a5fb5',
            style: { lineWidth: 2 },
            label: '\\text{double-layer charges}',
            labelFrac: 0.5,
            labelHAlign: 'center',
        },
    ]);
</script>
