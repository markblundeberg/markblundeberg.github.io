{% set idprefix = "kin-bv-explainer" %}
{% import "macros/controls.njk" as controls %}
<div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: center">
    <div class="bd-container" id="{{idprefix}}-levels" style="flex: 1 1 210px; height: 250px; max-width: 300px"></div>
    <div class="bd-container" id="{{idprefix}}-iv" style="flex: 1 1 240px; height: 250px; max-width: 340px"></div>
</div>
{{ controls.slider(idprefix + "-eta", "Overpotential $\\eta$", { min: -0.12, max: 0.12, step: "any", value: 0.05, snap: 0, readout: true, unit: "V" }) }}
{{ controls.slider(idprefix + "-alpha", "Symmetry $\\alpha$", { min: 0, max: 1, step: "any", value: 0.5, snap: 0.5, readout: true }) }}
<div style="text-align: center">{{ controls.checkbox(idprefix + "-log", "log-current (Tafel) view") }}</div>

<script type="module">
    import XYPlot from '{{ esbdJsPath }}XYPlot.js';
    import { SPECIES } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, linspace } from '{{ esbdJsPath }}utils.js';

    const BLUE = SPECIES.electron.color;
    // Butler-Volmer, one-electron: J/J0 = exp(α f η) − exp(−(1−α) f η),
    // f = F/RT = 38.92 V⁻¹ at 25 °C. α = 1 gives the Shockley diode law.
    const f = 38.92;
    const V_RXN = 0.5; // arbitrary; the barrier panel has abstract axes
    const B = 0.28; // equilibrium barrier depth, volts
    const JMAX = 15; // I–V panel y-limit; traces are trimmed where they exit

    // Left panel: the barrier picture behind alpha. The pass hangs BELOW the
    // levels (high electron energy = low voltage); its minimum sits at
    // V_TS = V_RXN − B + α·η, riding fraction α with the metal level.
    const bar = new XYPlot('{{idprefix}}-levels', {
        xLabel: 'Reaction coordinate',
        yLabel: 'Voltage $V_{\\mathrm{e}^-}$',
        xRange: [0, 1],
        yRange: [0.02, 0.76],
        xMode: 'abstract',
        yMode: 'abstract',
        margins: { bottom: 34, left: 26, right: 10 },
    });
    const smf = (t) => (t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t));

    const iv = new XYPlot('{{idprefix}}-iv', {
        xLabel: 'Overpotential $\\eta$ (V)',
        yLabel: 'Current $J/J_0$',
        xRange: [-0.12, 0.12],
        yRange: [-JMAX, JMAX],
        margins: { bottom: 34, left: 42, right: 10 },
    });

    const FAINT = { lineWidth: 1.25, opacity: 0.55 };

    function update() {
        const eta = parseFloat(etaEl.value);
        const alpha = parseFloat(alphaEl.value);
        const J = (e) => Math.exp(alpha * f * e) - Math.exp(-(1 - alpha) * f * e);

        const VL = V_RXN + eta; // metal side
        const VTS = V_RXN - B + alpha * eta; // transition state
        const bxs = linspace(0.25, 0.75, 101);
        const pass = bxs.map((x) =>
            x <= 0.5
                ? VTS + (VL - VTS) * smf((0.5 - x) / 0.25)
                : VTS + (V_RXN - VTS) * smf((x - 0.5) / 0.25)
        );
        bar.updateTraceData([
            {
                id: 'ref',
                x: [0.3, 0.98],
                y: [V_RXN - B, V_RXN - B],
                color: '#999',
                style: { lineWidth: 1, dasharray: '4,3', opacity: 0.5 },
                showLabel: false,
            },
            {
                id: 'left',
                x: [0.02, 0.25],
                y: [VL, VL],
                color: BLUE,
                style: { lineWidth: 3 },
                showLabel: false,
            },
            {
                id: 'right',
                x: [0.75, 0.98],
                y: [V_RXN, V_RXN],
                color: BLUE,
                style: { lineWidth: 3, dasharray: '3,3' },
                showLabel: false,
            },
            {
                id: 'pass',
                x: bxs,
                y: pass,
                color: '#667',
                style: { lineWidth: 1.5, dasharray: '2,2' },
                showLabel: false,
            },
            {
                id: 'lbl_e',
                x: [0.275, 0.285],
                y: [VL - 0.095, VL - 0.095],
                color: BLUE,
                style: { lineWidth: 0, opacity: 0 },
                label: '\\mathrm{e}^-',
                labelFrac: 0,
                labelHAlign: 'center',
            },
            {
                id: 'lbl_left',
                x: [0.02, 0.03],
                y: [VL + 0.07, VL + 0.07],
                color: BLUE,
                style: { lineWidth: 0, opacity: 0 },
                label: 'V_{\\mathrm{e}^-}',
                labelFrac: 1,
            },
            {
                id: 'lbl_right',
                x: [0.6, 0.61],
                y: [V_RXN + 0.07, V_RXN + 0.07],
                color: BLUE,
                style: { lineWidth: 0, opacity: 0 },
                label: 'V_{\\mathrm{e}^-}(\\mathrm{Ox}/\\mathrm{Red})',
                labelFrac: 1,
            },
        ]);
        bar.updateMarkers([
            { id: 'ts', x: 0.5, y: VTS, color: '#667', r: 3 },
            { id: 'e', x: 0.275, y: VL - 0.022, color: BLUE, r: 4.5 },
        ]);

        const logView = logEl.checked;
        const xs = linspace(-0.12, 0.12, 241);
        // trim a trace where it leaves the y-window (in the linear view the
        // exponential genuinely blows through the roof; let it exit mid-plot)
        const trim = (fn, lo, hi) => {
            const x = [], y = [];
            for (const e of xs) {
                const v = fn(e);
                if (v >= lo && v <= hi) { x.push(e); y.push(v); }
            }
            return { x, y };
        };
        const Ja = (e) => Math.exp(alpha * f * e);
        const Jc = (e) => -Math.exp(-(1 - alpha) * f * e);

        if (!logView) {
            iv.setYLabel('Current $J/J_0$');
            iv.setYRange(-JMAX, JMAX);
            iv.updateTraceData([
                {
                    id: 'anodic',
                    ...trim(Ja, -JMAX, JMAX),
                    color: BLUE,
                    style: FAINT,
                    label: 'J_{\\mathrm{a}}',
                    labelFrac: 0.93,
                    labelHAlign: 'right',
                },
                {
                    id: 'cathodic',
                    ...trim(Jc, -JMAX, JMAX),
                    color: '#E4571A',
                    style: FAINT,
                    label: '-J_{\\mathrm{c}}',
                    labelFrac: 0.07,
                },
                {
                    id: 'J',
                    ...trim(J, -JMAX, JMAX),
                    color: '#333',
                    style: { lineWidth: 2.5 },
                    label: '',
                },
            ]);
            const Jnow = J(eta);
            iv.updateMarkers(
                Math.abs(Jnow) <= JMAX
                    ? [{ id: 'op', x: eta, y: Jnow, color: '#333' }]
                    : []
            );
        } else {
            // Tafel view: log10|J/J0|. The partial currents become straight
            // lines (the Tafel asymptotes); |J| dives to -infinity at eta = 0,
            // so the notch bottom is trimmed and the branches drawn separately.
            const LO = -2,
                HI = 2.2;
            iv.setYLabel('$\\log_{10} |J/J_0|$');
            iv.setYRange(LO, HI);
            const logAbs = (fn) => (e) => Math.log10(Math.abs(fn(e)) + 1e-300);
            iv.updateTraceData([
                {
                    id: 'anodic',
                    ...trim(logAbs(Ja), LO, HI),
                    color: BLUE,
                    style: FAINT,
                    label: 'J_{\\mathrm{a}}',
                    labelFrac: 0.93,
                    labelHAlign: 'right',
                },
                {
                    id: 'cathodic',
                    ...trim(logAbs(Jc), LO, HI),
                    color: '#E4571A',
                    style: FAINT,
                    label: '|J_{\\mathrm{c}}|',
                    labelFrac: 0.07,
                },
                {
                    id: 'Jneg',
                    ...trim((e) => (e < 0 ? logAbs(J)(e) : LO - 1), LO, HI),
                    color: '#333',
                    style: { lineWidth: 2.5 },
                    label: '',
                },
                {
                    id: 'Jpos',
                    ...trim((e) => (e > 0 ? logAbs(J)(e) : LO - 1), LO, HI),
                    color: '#333',
                    style: { lineWidth: 2.5 },
                    label: '',
                },
            ]);
            const yNow = logAbs(J)(eta);
            iv.updateMarkers(
                yNow >= LO ? [{ id: 'op', x: eta, y: yNow, color: '#333' }] : []
            );
        }

        document.getElementById('{{idprefix}}-eta-readout').textContent =
            eta.toFixed(2);
        document.getElementById('{{idprefix}}-alpha-readout').textContent =
            alpha.toFixed(2);
    }

    const etaEl = makeSlider('{{idprefix}}-eta', update, { fire: false });
    const alphaEl = makeSlider('{{idprefix}}-alpha', update, { fire: false });
    const logEl = document.getElementById('{{idprefix}}-log');
    logEl.addEventListener('change', update);
    update();
</script>
