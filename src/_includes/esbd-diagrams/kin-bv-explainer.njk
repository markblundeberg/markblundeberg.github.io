{% set idprefix = "kin-bv-explainer" %}
{% import "macros/controls.njk" as controls %}
<div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: center">
    <div class="bd-container" id="{{idprefix}}-levels" style="flex: 1 1 210px; height: 250px; max-width: 300px"></div>
    <div class="bd-container" id="{{idprefix}}-iv" style="flex: 1 1 240px; height: 250px; max-width: 340px"></div>
</div>
{{ controls.slider(idprefix + "-eta", "Overpotential $\\eta$", { min: -0.12, max: 0.12, step: "any", value: 0.05, snap: 0, readout: true, unit: "V" }) }}
{{ controls.slider(idprefix + "-alpha", "Symmetry $\\alpha$", { min: 0, max: 1, step: "any", value: 0.5, snap: 0.5, readout: true }) }}
{{ controls.slider(idprefix + "-z", "Electrons $z$", { min: 1, max: 4, step: 1, value: 1, readout: true }) }}
<div style="text-align: center">{{ controls.checkbox(idprefix + "-log", "log-current (Tafel) view") }}</div>

<script type="module">
    import XYPlot from '{{ esbdJsPath }}XYPlot.js';
    import { SPECIES } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, linspace } from '{{ esbdJsPath }}utils.js';

    const BLUE = SPECIES.electron.color;
    // Butler-Volmer: J/J0 = exp(α z f η) − exp(−(1−α) z f η),
    // f = F/RT = 38.92 V⁻¹ at 25 °C. α = 1 gives the Shockley diode law.
    // z = electrons transferred together in the concerted step ("hop as
    // buddies"): it multiplies f, so each unit of η counts z times over and
    // the curve steepens by z. The barrier panel stays a one-electron schematic.
    const f = 38.92;
    const V_RXN = 0.5; // arbitrary; the barrier panel has abstract axes
    const B = 0.28; // equilibrium barrier depth, volts
    const JMAX = 15; // I–V panel y-limit; traces are trimmed where they exit
    const EGAP = 0.032; // reaction-coordinate spacing between buddy electrons

    // Left panel: the barrier picture behind alpha. The pass hangs BELOW the
    // levels (high electron energy = low voltage); its minimum sits at
    // V_TS = V_RXN − B + α·η, riding fraction α with the metal level.
    const bar = new XYPlot('{{idprefix}}-levels', {
        xLabel: 'Reaction coordinate',
        yLabel: 'Voltage $V_{\\mathrm{e}^-}$',
        xRange: [0, 1],
        yRange: [0.02, 0.76],
        xMode: 'abstract',
        yMode: 'abstract',
        margins: { bottom: 34, left: 26, right: 10 },
    });
    const smf = (t) => (t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t));
    // small arrow as a polyline trace; head geometry computed in ~pixel space
    const KX = 210,
        KY = 260; // nominal px per data unit (barrier panel)
    const arrowTrace = (id, x1, y1, x2, y2) => {
        const X1 = x1 * KX,
            Y1 = -y1 * KY,
            X2 = x2 * KX,
            Y2 = -y2 * KY;
        const L = Math.hypot(X2 - X1, Y2 - Y1) || 1;
        const ux = (X2 - X1) / L,
            uy = (Y2 - Y1) / L;
        const BX = X2 - 7 * ux,
            BY = Y2 - 7 * uy;
        const pts = [
            [X1, Y1],
            [X2, Y2],
            [BX - 3.5 * uy, BY + 3.5 * ux],
            [X2, Y2],
            [BX + 3.5 * uy, BY - 3.5 * ux],
        ];
        return {
            id,
            x: pts.map((q) => q[0] / KX),
            y: pts.map((q) => -q[1] / KY),
            color: '#667',
            style: { lineWidth: 1.3 },
            showLabel: false,
        };
    };
    let animGeom = null; // set by update(); read by the electron animator

    const iv = new XYPlot('{{idprefix}}-iv', {
        xLabel: 'Overpotential $\\eta$ (V)',
        yLabel: 'Current $J/J_0$',
        xRange: [-0.12, 0.12],
        yRange: [-JMAX, JMAX],
        margins: { bottom: 34, left: 42, right: 10 },
        clipTraces: true,
    });

    const FAINT = { lineWidth: 1.25, opacity: 0.55 };

    function update() {
        const eta = parseFloat(etaEl.value);
        const alpha = parseFloat(alphaEl.value);
        const z = parseInt(zEl.value, 10);
        const J = (e) => Math.exp(alpha * z * f * e) - Math.exp(-(1 - alpha) * z * f * e);

        const VL = V_RXN + eta; // metal side
        const VTS = V_RXN - B + alpha * eta; // transition state
        const passAt = (x) =>
            x <= 0.5
                ? VTS + (VL - VTS) * smf((0.5 - x) / 0.25)
                : VTS + (V_RXN - VTS) * smf((x - 0.5) / 0.25);
        const bxs = linspace(0.25, 0.75, 101);
        const pass = bxs.map(passAt);
        // electron travels emitter -> collector = low-V side -> high-V side
        const sgn = eta >= 0 ? 1 : -1; // +1: solution emits, metal collects
        const active = Math.abs(eta) > 0.008;
        animGeom = { sgn, passAt, active, z };
        const barTraces = [
            {
                id: 'ref',
                x: [0.3, 0.98],
                y: [V_RXN - B, V_RXN - B],
                color: '#999',
                style: { lineWidth: 1, dasharray: '4,3', opacity: 0.5 },
                showLabel: false,
            },
            {
                id: 'left',
                x: [0.02, 0.25],
                y: [VL, VL],
                color: BLUE,
                style: { lineWidth: 3 },
                showLabel: false,
            },
            {
                id: 'right',
                x: [0.75, 0.98],
                y: [V_RXN, V_RXN],
                color: BLUE,
                style: { lineWidth: 3, dasharray: '3,3' },
                showLabel: false,
            },
            {
                id: 'pass',
                x: bxs,
                y: pass,
                color: '#667',
                style: { lineWidth: 1.5, dasharray: '2,2' },
                showLabel: false,
            },
            {
                id: 'lbl_left',
                x: [0.02, 0.03],
                y: [VL + 0.07, VL + 0.07],
                color: BLUE,
                style: { lineWidth: 0, opacity: 0 },
                label: 'V_{\\mathrm{e}^-}',
                labelFrac: 1,
            },
            {
                id: 'lbl_right',
                x: [0.6, 0.61],
                y: [V_RXN + 0.07, V_RXN + 0.07],
                color: BLUE,
                style: { lineWidth: 0, opacity: 0 },
                label: 'V_{\\mathrm{e}^-}(\\mathrm{Ox}/\\mathrm{Red})',
                labelFrac: 1,
            },
        ];
        if (active) {
            const vEm = sgn > 0 ? V_RXN : VL;
            const vCol = sgn > 0 ? VL : V_RXN;
            barTraces.push(
                arrowTrace(
                    'arr_down',
                    0.5 + 0.22 * sgn,
                    vEm - 0.035,
                    0.5 + 0.055 * sgn,
                    VTS + 0.035
                ),
                arrowTrace(
                    'arr_up',
                    0.5 - 0.055 * sgn,
                    VTS + 0.035,
                    0.5 - 0.22 * sgn,
                    vCol - 0.035
                )
            );
        }
        bar.updateTraceData(barTraces);
        // parked electron positions (the animator takes over when live); no
        // crossing at eta ~ 0, so no electrons either. z of them ride the pass
        // as a queue — "hop as buddies" — trailing the leader toward the shelf.
        const xp = 0.5 + 0.14 * sgn;
        const emarks = active
            ? Array.from({ length: z }, (_, i) => {
                  const xi = xp + i * EGAP * sgn;
                  return { id: 'e' + i, x: xi, y: passAt(xi) - 0.022, color: BLUE, r: 4.5 };
              })
            : [];
        bar.updateMarkers([
            { id: 'ts', x: 0.5, y: VTS, color: '#667', r: 3 },
            ...emarks,
        ]);

        const logView = logEl.checked;
        const xs = linspace(-0.12, 0.12, 241);
        // Keep every grid point (constant count → smooth D3 path transitions);
        // clamp values that blow past the window to just outside it and let the
        // plot's clip-path cut them at the axis. Dropping points instead makes
        // the path length jump and the transition interpolate garbage.
        const trim = (fn, lo, hi) => {
            const span = hi - lo,
                ylo = lo - span,
                yhi = hi + span;
            return {
                x: xs,
                y: xs.map((e) => {
                    const v = fn(e);
                    return v < ylo ? ylo : v > yhi ? yhi : v;
                }),
            };
        };
        const Ja = (e) => Math.exp(alpha * z * f * e);
        const Jc = (e) => -Math.exp(-(1 - alpha) * z * f * e);

        if (!logView) {
            iv.setYLabel('Current $J/J_0$');
            iv.setYRange(-JMAX, JMAX);
            iv.updateTraceData([
                {
                    id: 'anodic',
                    ...trim(Ja, -JMAX, JMAX),
                    color: BLUE,
                    style: FAINT,
                    label: 'J_{\\mathrm{a}}',
                    labelFrac: 0.93,
                    labelHAlign: 'right',
                },
                {
                    id: 'cathodic',
                    ...trim(Jc, -JMAX, JMAX),
                    color: SPECIES.hole.color,
                    style: FAINT,
                    label: '-J_{\\mathrm{c}}',
                    labelFrac: 0.07,
                },
                {
                    id: 'J',
                    ...trim(J, -JMAX, JMAX),
                    color: '#333',
                    style: { lineWidth: 2.5 },
                    label: '',
                },
            ]);
            const Jnow = J(eta);
            iv.updateMarkers(
                Math.abs(Jnow) <= JMAX
                    ? [{ id: 'op', x: eta, y: Jnow, color: '#333' }]
                    : []
            );
        } else {
            // Tafel view: log10|J/J0|. The partial currents become straight
            // lines (the Tafel asymptotes); |J| dives to -infinity at eta = 0,
            // so the notch bottom is trimmed and the branches drawn separately.
            const LO = -2,
                HI = 2.2;
            iv.setYLabel('$\\log_{10} |J/J_0|$');
            iv.setYRange(LO, HI);
            const logAbs = (fn) => (e) => Math.log10(Math.abs(fn(e)) + 1e-300);
            iv.updateTraceData([
                {
                    id: 'anodic',
                    ...trim(logAbs(Ja), LO, HI),
                    color: BLUE,
                    style: FAINT,
                    label: 'J_{\\mathrm{a}}',
                    labelFrac: 0.93,
                    labelHAlign: 'right',
                },
                {
                    id: 'cathodic',
                    ...trim(logAbs(Jc), LO, HI),
                    color: SPECIES.hole.color,
                    style: FAINT,
                    label: '|J_{\\mathrm{c}}|',
                    labelFrac: 0.07,
                },
                {
                    id: 'Jneg',
                    ...trim((e) => (e < 0 ? logAbs(J)(e) : LO - 1), LO, HI),
                    color: '#333',
                    style: { lineWidth: 2.5 },
                    label: '',
                },
                {
                    id: 'Jpos',
                    ...trim((e) => (e > 0 ? logAbs(J)(e) : LO - 1), LO, HI),
                    color: '#333',
                    style: { lineWidth: 2.5 },
                    label: '',
                },
            ]);
            const yNow = logAbs(J)(eta);
            iv.updateMarkers(
                yNow >= LO ? [{ id: 'op', x: eta, y: yNow, color: '#333' }] : []
            );
        }

        document.getElementById('{{idprefix}}-eta-readout').textContent =
            eta.toFixed(2);
        document.getElementById('{{idprefix}}-alpha-readout').textContent =
            alpha.toFixed(2);
        document.getElementById('{{idprefix}}-z-readout').textContent = z;
    }

    const etaEl = makeSlider('{{idprefix}}-eta', update, { fire: false });
    const alphaEl = makeSlider('{{idprefix}}-alpha', update, { fire: false });
    const zEl = makeSlider('{{idprefix}}-z', update, { fire: false });
    const logEl = document.getElementById('{{idprefix}}-log');
    logEl.addEventListener('change', update);
    update();

    // the extra points: the electron makes the crossing, emitter to
    // collector, looping. Skipped under ?static (deterministic captures);
    // the parked marker from updateMarkers stands in.
    if (!new URLSearchParams(location.search).has('static')) {
        const PERIOD = 2400,
            TRAVEL = 1800;
        const ease = (t) => t * t * (3 - 2 * t);
        function hop(ts) {
            if (animGeom && animGeom.active && bar.xScale) {
                const s = Math.min(1, (ts % PERIOD) / TRAVEL);
                const xLead = 0.5 + (0.25 - 0.5 * ease(s)) * animGeom.sgn;
                const sel = bar.markersGroup.selectAll('.xy-marker');
                for (let i = 0; i < animGeom.z; i++) {
                    const x = xLead + i * EGAP * animGeom.sgn;
                    const y = animGeom.passAt(x) - 0.022;
                    sel.filter((d) => d.id === 'e' + i)
                        .attr('cx', bar.xScale(x))
                        .attr('cy', bar.yScale(y));
                }
            }
            requestAnimationFrame(hop);
        }
        requestAnimationFrame(hop);
    }
</script>
