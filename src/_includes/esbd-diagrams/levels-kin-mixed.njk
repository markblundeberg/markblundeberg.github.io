{% set idprefix = "levels-kin-mixed" %}
{% import "macros/controls.njk" as controls %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 280px"></div>
{{ controls.slider(idprefix + "-ratio", "$\\log_{10}(J_{0,\\mathrm{O_2}}/J_{0,\\mathrm{Fe}})$", { min: -3, max: 3, step: "any", value: -1, snap: 0, readout: true }) }}

<script type="module">
    import EnergyLevelsDiagram from '{{ esbdJsPath }}EnergyLevelsDiagram.js';
    import { SPECIES } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider } from '{{ esbdJsPath }}utils.js';

    const BLUE = SPECIES.electron.color;
    // A corroding metal coupled to two half-reactions at once. The metal
    // floats to where the two Butler-Volmer currents cancel; with both
    // α = 0.5 and the two levels many kT/e apart, both couples sit in their
    // Tafel regimes and the balance point is analytic:
    //   V_m = (V_O2 + V_Fe)/2 + (kT/e)·ln(J0_O2/J0_Fe)
    // — the mixed potential slides toward the couple with the faster
    // kinetics. Level heights are schematic (aerated ~neutral water).
    const V_O2 = 0.85; // V_e-(O2/OH-) — the oxygen couple
    const V_FE = 0.15; // V_e-(Fe2+/Fe) — the metal-dissolution couple
    const DEC = 0.05916;

    const diagram = new EnergyLevelsDiagram('{{idprefix}}-container', {
        yAxisLabel: 'Voltage $V_{\\mathrm{e}^-}$',
        yRange: [-0.02, 1.02],
        categories: [
            { id: 'elec', label: 'Electrode' },
            { id: 'soln', label: 'Solution' },
        ],
        showYTicks: false,
        bandPaddingOuter: 0.5,
        bandMinPaddingOuter: { left: 15, right: 95 },
        bandMinPaddingInner: 34,
    });

    function update(r) {
        const Vm = (V_O2 + V_FE) / 2 + DEC * r; // Tafel-limit balance (59.2 mV per decade of J0 ratio at alpha = 0.5, z = 1)

        diagram.setLevels([
            {
                categoryId: 'elec',
                levelId: 'metal',
                yValue: Vm,
                label: 'V_{\\mathrm{e}^-}',
                color: BLUE,
                style: { lineWidth: 3 },
            },
            {
                categoryId: 'soln',
                levelId: 'o2',
                yValue: V_O2,
                label: 'V_{\\mathrm{e}^-}(\\mathrm{O_2}/\\mathrm{OH}^-)',
                color: BLUE,
                style: { lineWidth: 3, dasharray: '3,3' },
            },
            {
                categoryId: 'soln',
                levelId: 'fe',
                yValue: V_FE,
                label: 'V_{\\mathrm{e}^-}(\\mathrm{Fe}^{2+}\\!/\\mathrm{Fe})',
                color: BLUE,
                style: { lineWidth: 3, dasharray: '3,3' },
            },
        ]);

        diagram.setArrows([
            {
                arrowId: 'eta_o2',
                fromLevelId: 'o2',
                toLevelId: 'metal',
                label: '\\eta_{\\mathrm{O_2}}',
                arrowStyle: '->',
            },
            {
                arrowId: 'eta_fe',
                fromLevelId: 'fe',
                toLevelId: 'metal',
                label: '\\eta_{\\mathrm{Fe}}',
                arrowStyle: '->',
            },
        ]);

        document.getElementById('{{idprefix}}-ratio-readout').textContent =
            r.toFixed(1);
    }

    makeSlider('{{idprefix}}-ratio', update);
</script>
