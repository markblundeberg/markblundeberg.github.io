{% set idprefix = "esbd-ambipolar-cap" %}
<div class="bd-container" id="{{idprefix}}" style="height: 235px; max-width: 340px"></div>

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { drawCapacitors } from '{{ esbdJsPath }}utils.js';

    // A static ESBD of three co-located ions, with a mutual chemical
    // capacitor drawn between each pair of V_i rails. These are NOT dielectric
    // capacitors: nothing here references phi or a standard state. Charge shifted
    // onto one rail and off another (the pocket staying neutral) opens that pair's
    // V_i - V_j gap, exactly as a capacitor stores charge for a voltage. Three
    // carriers close the set into a triangle of three such capacitors. The plates
    // are coloured by the two rails they bridge; the outer (Na-H) capacitor's wire
    // crosses the Cl rail without a junction dot (a plain crossing, no connection).
    const V = { na: 0.55, cl: 0.0, h: -0.55 };
    const esbd = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}',
        { sodium: SPECIES.sodium, chloride: SPECIES.chloride, proton: SPECIES.proton },
        { yMode: 'abstract', margins: { right: 66, left: 30 } }
    );
    esbd.setSpatialLayout([0, 1], [{ ...REGION.solution, name: 'one solution' }]);
    esbd.diagram.setYLabel('Species voltage');
    esbd.setVRange(-0.95, 0.95);

    esbd.updateTraceData([
        { id: 'na', speciesId: 'sodium', curveType: 'voltage', label: 'V_{\\mathrm{Na}^+}', x: [0, 1], y: [V.na, V.na] },
        { id: 'cl', speciesId: 'chloride', curveType: 'voltage', label: 'V_{\\mathrm{Cl}^-}', x: [0, 1], y: [V.cl, V.cl] },
        { id: 'h', speciesId: 'proton', curveType: 'voltage', label: 'V_{\\mathrm{H}^+}', x: [0, 1], y: [V.h, V.h] },
    ]);

    // One capacitor per pair of rails, via the shared helper + custom-draw hook.
    // pcf nudges the outer (Na-H) capacitor's plates into the upper gap so they
    // don't land on the Cl rail; its wire crosses Cl as a plain crossing.
    esbd.setCustomDrawCallback((bd) =>
        drawCapacitors(bd, [
            { id: 'na-cl', x: 0.30, hi: V.na, lo: V.cl, cHi: SPECIES.sodium.color, cLo: SPECIES.chloride.color },
            { id: 'cl-h', x: 0.50, hi: V.cl, lo: V.h, cHi: SPECIES.chloride.color, cLo: SPECIES.proton.color },
            { id: 'na-h', x: 0.72, hi: V.na, lo: V.h, cHi: SPECIES.sodium.color, cLo: SPECIES.proton.color, pcf: 0.30 },
        ], { plateHalfWidth: 14 })
    );
</script>
