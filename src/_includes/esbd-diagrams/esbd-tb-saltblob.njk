{% set idprefix = "esbd-tb-saltblob" %}
{% import "macros/controls.njk" as controls %}
<div class="bd-container" id="{{idprefix}}-band" style="height: 220px"></div>
<div class="bd-container" id="{{idprefix}}-conc" style="height: 140px"></div>
{{ controls.slider(idprefix + "-t", "Time", { min: 0.03, max: 1, step: "any", value: 0.08, readout: true }) }}

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import XYPlot from '{{ esbdJsPath }}XYPlot.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, linspace } from '{{ esbdJsPath }}utils.js';

    // A blob of 1:1 salt spreading as one widening Gaussian (ambipolar D,
    // analytic solution — scrub time with the slider). D+ = 3·D−, so the
    // diffusion potential holds the fast cation back and urges the anion
    // on: on the band diagram the slow anion carries the LARGER V-feature
    // (it needs the bigger push to keep up). A dilute tracer cation rides
    // the same field: its CENTER is integrated exactly (within the model)
    // from dx/dt = M·r·∂ₓln c — with the fast-cation salt the field points
    // INWARD (outer region charges +), so the tracer is drawn UP the salt
    // gradient, toward the blob. Its width spreads by its own diffusion
    // only (field-gradient dispersion neglected).
    const D = 0.015;
    const AMP = 0.05,
        CBG = 0.02;
    const RMOB = 0.5; // (D+ − D−)/(D+ + D−) with D+ = 3 D−
    const DEC = 0.05916;
    const GAPBG = 0.14; // rung gap out in the background salt (~10^-2.4 M)
    // Ions are a GENERIC M+/X− salt with D+ = 3 D− (round-2 X-8: the old
    // NaCl costume had every asymmetry backwards — real NaCl's anion is
    // the faster one). Rung spacing compressed: anchoring M+ as
    // drawn-true, the X− pair carries a generic NaCl-scale shift. The two
    // rungs move as one rigid ladder, dipping together by RMOB·DEC·lg
    // over the blob: the diffusion potential itself.
    const X_SHIFT = -4.63;

    const band = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-band',
        {
            cation: { ...SPECIES.sodium, mathLabel: '\\mathrm{M}^{+}' },
            anion: { ...SPECIES.chloride, mathLabel: '\\mathrm{X}^{-}' },
        },
        { margins: { right: 56 } }
    );
    band.setSpatialLayout([0, 1], [REGION.solution]);
    band.setVRange(0.05, 0.98);

    const conc = new XYPlot('{{idprefix}}-conc', {
        xLabel: '',
        yLabel: 'Concentration',
        xRange: [0, 1],
        yRange: [0, 0.9],
        xMode: 'abstract',
        yMode: 'abstract',
        margins: { top: 4, bottom: 12, left: 26, right: 56 },
    });

    const xs = linspace(0, 1, 161);
    const XTR0 = 0.62,
        T0 = 0.03; // tracer release point and earliest slider time
    const MTR = 0.02; // tracer mobility scale (drift per unit ∂ₓln c)
    const cAt = (x, tt) => {
        const s2 = 4 * D * tt;
        return (
            CBG + (AMP / Math.sqrt(Math.PI * s2)) * Math.exp(-((x - 0.5) ** 2) / s2)
        );
    };
    // deterministic fixed-step integration of the tracer center from T0
    const tracerX = (tEnd) => {
        let x = XTR0;
        const dt = 0.004;
        for (let tt = T0; tt < tEnd; tt += dt) {
            const h = 0.004;
            const dlnc =
                (Math.log(cAt(x + h, tt)) - Math.log(cAt(x - h, tt))) / (2 * h);
            x += MTR * RMOB * dlnc * dt;
        }
        return x;
    };

    function update(t) {
        document.getElementById('{{idprefix}}-t-readout').textContent =
            t.toFixed(2);
        const c = (x) => cAt(x, t);
        const lg = (x) => Math.log10(c(x) / CBG);
        // tracer center from the integrated drift equation; width by its
        // own diffusion only
        const xtr = tracerX(t);
        const str2 = 0.0015 + 0.004 * (t - T0);
        const ctr = (x) =>
            0.1 * Math.exp(-((x - xtr) ** 2) / str2);

        band.updateTraceData([
            {
                id: 'vp',
                speciesId: 'cation',
                curveType: 'voltage',
                x: [...xs],
                y: xs.map((x) => 0.66 + (1 - RMOB) * DEC * lg(x)),
            },
            {
                id: 'v0p',
                speciesId: 'cation',
                curveType: 'standardState',
                x: [...xs],
                y: xs.map((x) => 0.66 + GAPBG - RMOB * DEC * lg(x)),
            },
            {
                id: 'vm',
                speciesId: 'anion',
                curveType: 'voltage',
                refShift: X_SHIFT,
                x: [...xs],
                y: xs.map((x) => 0.38 - (1 + RMOB) * DEC * lg(x)),
            },
            {
                id: 'v0m',
                speciesId: 'anion',
                curveType: 'standardState',
                refShift: X_SHIFT,
                x: [...xs],
                y: xs.map((x) => 0.38 - GAPBG - RMOB * DEC * lg(x)),
            },
        ]);

        conc.updateTraceData([
            {
                id: 'cs',
                x: [...xs],
                y: xs.map(c),
                color: SPECIES.sodium.color,
                style: { lineWidth: 2 },
                label: 'c_{+}{=}c_{-}',
                labelFrac: 0.32,
                labelHAlign: 'right',
            },
            {
                id: 'ctr',
                x: [...xs],
                y: xs.map(ctr),
                color: '#7a5fb5',
                style: { lineWidth: 2, dasharray: '4,3' },
                label: '\\text{tracer}',
                labelFrac: 0.78,
            },
        ]);
    }

    makeSlider('{{idprefix}}-t', update);
</script>
