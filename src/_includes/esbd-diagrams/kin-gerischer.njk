{% set idprefix = "kin-gerischer" %}
{% import "macros/controls.njk" as controls %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 300px"></div>
{{ controls.slider(idprefix + "-ratio", "$\\log_{10}(c_{\\mathrm{Ox}}/c_{\\mathrm{Red}})$", { min: -2, max: 2, step: "any", value: 0, snap: 0, readout: true }) }}

<script type="module">
    import XYPlot from '{{ esbdJsPath }}XYPlot.js';
    import { SPECIES } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, linspace } from '{{ esbdJsPath }}utils.js';

    const BLUE = SPECIES.electron.color;
    // Marcus–Gerischer bumps, drawn sideways on a V_e- axis (energy up =
    // voltage down, so the FILLED D_red bump sits ABOVE the couple's levels
    // and the empty D_ox below). The bumps sit ±λ about the STANDARD level
    // V°_e-(Ox/Red) (Gerischer's E°, always their midpoint); Gaussian width
    // σ = sqrt(2λkT) (Marcus), λ = 0.35 V → σ = 0.134 V. Amplitudes scale
    // with the actual Ox and Red concentrations — densities of real ions.
    // Gauge: the couple's ACTUAL level V_e-(Ox/Red) is pinned (the electron
    // reservoir stays put) and the standard level + bump structure slide
    // beneath it by the Nernst term as the ratio changes.
    const KT = 0.0257;
    const LAMBDA = 0.35;
    const SIGMA = Math.sqrt(2 * LAMBDA * KT);
    const V_RXN = 0.5; // the couple's actual level, pinned
    const DEC = 0.05916;

    const plot = new XYPlot('{{idprefix}}-container', {
        xLabel: 'Density of states',
        yLabel: 'Voltage $V_{\\mathrm{e}^-}$ (V)',
        xRange: [0, 1.18],
        yRange: [-0.42, 1.42],
        xMode: 'abstract',
        margins: { bottom: 34, left: 42, right: 12 },
    });

    const vgrid = linspace(-0.42, 1.42, 211);
    const gauss = (v, c, amp) =>
        amp * Math.exp(-(((v - c) / SIGMA) ** 2) / 2);

    function update() {
        const r = parseFloat(ratioEl.value);
        const V0 = V_RXN - DEC * r; // standard level slides under the pinned V_rxn
        const fRed = 1 / (1 + Math.pow(10, r)); // fraction Red
        const fOx = 1 - fRed;
        const below = V0 <= V_RXN; // keep the two level labels apart

        plot.updateTraceData([
            // filled Gaussians, no edge lines; occupancy carried by the
            // fill density (both stay electron blue - these are electron
            // states either way)
            {
                id: 'dred',
                x: vgrid.map((v) => gauss(v, V0 + LAMBDA, fRed)),
                y: [...vgrid],
                color: BLUE,
                style: { lineWidth: 0, fillOpacity: 0.45 },
                showLabel: false,
            },
            {
                id: 'dox',
                x: vgrid.map((v) => gauss(v, V0 - LAMBDA, fOx)),
                y: [...vgrid],
                color: BLUE,
                style: { lineWidth: 0, fillOpacity: 0.13 },
                showLabel: false,
            },
            {
                id: 'v0',
                x: [0, 1.15],
                y: [V0, V0],
                color: BLUE,
                style: { lineWidth: 1, dasharray: '3,3' },
                showLabel: false,
            },
            {
                id: 'vrxn',
                x: [0, 1.15],
                y: [V_RXN, V_RXN],
                color: BLUE,
                style: { lineWidth: 3, dasharray: '3,3' },
                showLabel: false,
            },
            {
                id: 'lbl_v0',
                x: [1.13, 1.14],
                y: [V0 + (below ? -0.09 : 0.08), V0 + (below ? -0.09 : 0.08)],
                color: BLUE,
                style: { lineWidth: 0, opacity: 0 },
                label: 'V^\\circ_{\\mathrm{e}^-}(\\mathrm{Ox}/\\mathrm{Red})',
                labelFrac: 1,
                labelHAlign: 'right',
            },
            {
                id: 'lbl_vrxn',
                x: [1.13, 1.14],
                y: [V_RXN + (below ? 0.08 : -0.09), V_RXN + (below ? 0.08 : -0.09)],
                color: BLUE,
                style: { lineWidth: 0, opacity: 0 },
                label: 'V_{\\mathrm{e}^-}(\\mathrm{Ox}/\\mathrm{Red})',
                labelFrac: 1,
                labelHAlign: 'right',
            },
            // label stubs at the bump peaks
            {
                id: 'lbl_red',
                x: [fRed + 0.03, fRed + 0.04],
                y: [V0 + LAMBDA, V0 + LAMBDA],
                color: BLUE,
                style: { lineWidth: 0, opacity: 0 },
                label: 'D_{\\mathrm{red}}\\;\\text{(filled)}',
                labelFrac: 1,
            },
            {
                id: 'lbl_ox',
                x: [fOx + 0.03, fOx + 0.04],
                y: [V0 - LAMBDA, V0 - LAMBDA],
                color: BLUE,
                style: { lineWidth: 0, opacity: 0 },
                label: 'D_{\\mathrm{ox}}\\;\\text{(empty)}',
                labelFrac: 1,
            },
        ]);

        document.getElementById('{{idprefix}}-ratio-readout').textContent =
            r.toFixed(1);
    }

    const ratioEl = makeSlider('{{idprefix}}-ratio', update, { fire: false });
    update();
</script>
