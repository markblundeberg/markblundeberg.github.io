{% set idprefix = "esbd-cc-ities" %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 270px"></div>

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { linspace } from '{{ esbdJsPath }}utils.js';

    // Schematic ITIES with a generic 1:1 salt C+ A- partitioning between water
    // and an immiscible organic solvent. Chemistry deliberately left generic
    // (no specific system settled on yet); to make it concrete, set the two
    // water-side gaps and the organic-side gaps from a real salt's transfer
    // energies. For any single 1:1 salt, electroneutrality makes the two
    // rungs deform (bulk to bulk) EQUALLY AND OPPOSITELY by
    // (RT/2F)ln(1/(K_C·K_A)) — the PRODUCT of the ions' partition
    // coefficients, i.e. half the salt's transfer energy per F, the
    // measurable combination. (The RATIO combination (RT/2F)ln(K_C/K_A) is
    // the distribution potential Δφ itself: it shifts both rungs rigidly and
    // is gauge-invisible here.) The salt prefers water, so both organic-side
    // gaps widen: the ladder stretches rather than stepping rigidly.
    //
    // Drawn heterojunction-style (cf. esbd-es-hetero, 2026-07-10): within
    // each solvent the ladder is rigid, so near the contact the two rungs
    // bend TOGETHER (a common double-layer dip — the electrostatics), while
    // right at the boundary each rung takes its own sharp species-specific
    // step (the transfer chemistry). Bending amplitude/sign and the
    // bend-vs-step split are schematic (double-layer structure is
    // concentration-dependent and convention-laden anyway).
    const GAP_W = 0.13; // |V_i - V°_i| in water (both ions; c_w equal by neutrality)
    const GAP_O = 0.3; // |gap| in the organic phase (same for both ions)
    const V_C = 0.4,
        V_A = -0.4; // the shared ions' flat voltages (gauge arbitrary)
    const XC = 0.5; // contact position
    const LW = 0.04,
        LO = 0.075; // screening lengths, water | organic (water screens harder)
    const BEND = -0.05; // common double-layer dip of the ladder at each contact face

    const diagram = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-container',
        {
            cation: { z: 1, color: SPECIES.potassium.color, mathLabel: '\\mathrm{C}^{+}' },
            anion: { z: -1, color: SPECIES.nitrate.color, mathLabel: '\\mathrm{A}^{-}' },
        },
        { yMode: 'abstract', margins: { right: 62, left: 28 } }
    );
    diagram.setSpatialLayout([0, 0.5, 1], [
        { ...REGION.solution, name: 'Water' },
        { ...REGION.solution2, name: 'Organic' },
    ]);
    diagram.setVRange(-0.9, 0.9);

    // one x array with the contact doubled, so each rung draws its sharp step
    const xw = linspace(0, XC, 101);
    const xo = linspace(XC, 1, 101);
    const x = [...xw, ...xo];
    // common-mode ladder bending: exponential double-layer tails on each side
    const bendW = xw.map((xi) => BEND * Math.exp(-(XC - xi) / LW));
    const bendO = xo.map((xi) => BEND * Math.exp(-(xi - XC) / LO));
    const rung = (bulkW, bulkO) => [
        ...bendW.map((b, k) => bulkW + b),
        ...bendO.map((b, k) => bulkO + b),
    ];

    diagram.updateTraceData([
        {
            id: 'v0c',
            speciesId: 'cation',
            curveType: 'standardState',
            labelFrac: 0.1,
            x: x,
            y: rung(V_C + GAP_W, V_C + GAP_O),
        },
        {
            id: 'vc',
            speciesId: 'cation',
            curveType: 'voltage',
            x: [0, 1],
            y: [V_C, V_C],
        },
        {
            id: 'va',
            speciesId: 'anion',
            curveType: 'voltage',
            x: [0, 1],
            y: [V_A, V_A],
        },
        {
            id: 'v0a',
            speciesId: 'anion',
            curveType: 'standardState',
            labelFrac: 0.1,
            x: x,
            y: rung(V_A - GAP_W, V_A - GAP_O),
        },
    ]);
</script>
