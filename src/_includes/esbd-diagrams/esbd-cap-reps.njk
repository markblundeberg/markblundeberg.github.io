{% set idprefix = "esbd-cap-reps" %}
<div style="display: flex; flex-wrap: wrap; justify-content: space-evenly; gap: 6px">
<div style="flex: 1; min-width: 200px; max-width: 280px">
<div style="text-align: center; font-size: 0.85em">per-carrier</div>
<div class="bd-container" id="{{idprefix}}-int" style="height: 240px; border: 1px solid #eee"></div>
</div>
<div style="flex: 1; min-width: 200px; max-width: 280px">
<div style="text-align: center; font-size: 0.85em">ambipolar</div>
<div class="bd-container" id="{{idprefix}}-amb" style="height: 240px; border: 1px solid #eee"></div>
</div>
</div>

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { drawCapacitors } from '{{ esbdJsPath }}utils.js';

    // Two representations of the SAME chemical capacitance in an intercalation
    // host (electrons + Li+ co-located), drawn side by side as two static
    // panels (Mark 2026-07-10; this was a checkbox toggle, but nothing here
    // needs interactivity). Per-carrier: one capacitor from each rail to its
    // own standard state (V_i -||- V°_i, and V°_i tracks φ). Ambipolar: the
    // two in series with the standard-state (φ) node eliminated, a single
    // rail-to-rail capacitor V_e- -||- V_Li+ — the V° levels are gone with it,
    // dramatising that the standard-state node has been eliminated.
    const ELE = SPECIES.electron.color, LI = SPECIES.lithium.color;
    const VE = 0.45, VE0 = 0.15, VLI0 = -0.15, VLI = -0.45;
    const X = 0.5;

    const T = {
        ve: { id: 've', speciesId: 'electron', curveType: 'voltage', label: 'V_{\\mathrm{e}^-}', x: [0, 1], y: [VE, VE] },
        ve0: { id: 've0', speciesId: 'electron', curveType: 'standardState', label: 'V^\\circ_{\\mathrm{e}^-}', x: [0, 1], y: [VE0, VE0] },
        vli0: { id: 'vli0', speciesId: 'lithium', curveType: 'standardState', label: 'V^\\circ_{\\mathrm{Li}^+}', x: [0, 1], y: [VLI0, VLI0] },
        vli: { id: 'vli', speciesId: 'lithium', curveType: 'voltage', label: 'V_{\\mathrm{Li}^+}', x: [0, 1], y: [VLI, VLI] },
    };

    function makePanel(containerId, yLabel) {
        const esbd = new ElectrochemicalSpeciesBandDiagram(
            containerId,
            { electron: SPECIES.electron, lithium: SPECIES.lithium },
            { yMode: 'abstract', margins: { right: 62, left: 26 } }
        );
        esbd.setSpatialLayout([0, 1], [{ ...REGION.solid, name: 'intercalation host' }]);
        esbd.diagram.setYLabel(yLabel);
        esbd.setVRange(-0.8, 0.8);
        return esbd;
    }

    const int = makePanel('{{idprefix}}-int', 'Species voltage');
    const amb = makePanel('{{idprefix}}-amb', ''); // one axis label serves both

    int.setCustomDrawCallback((bd) => drawCapacitors(bd, [
        { id: 'e-int', x: X, hi: VE, lo: VE0, cHi: ELE, cLo: ELE },
        { id: 'li-int', x: X, hi: VLI0, lo: VLI, cHi: LI, cLo: LI },
    ]));
    int.updateTraceData([T.ve, T.ve0, T.vli0, T.vli]);

    amb.setCustomDrawCallback((bd) => drawCapacitors(bd, [
        { id: 'amb', x: X, hi: VE, lo: VLI, cHi: ELE, cLo: LI },
    ]));
    amb.updateTraceData([T.ve, T.vli]);
</script>
