{% set idprefix = "esbd-oc-metal" %}
{% import "macros/controls.njk" as controls %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 200px"></div>
{{ controls.slider(idprefix + "-j", "Current", { min: -1, max: 1, step: "any", value: 0.6, snap: 0, readout: true }) }}

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider } from '{{ esbdJsPath }}utils.js';

    // A metal wire: the whole electrical story is one V_e- trace, flat at
    // equilibrium, sloping by Ohm's law under current. Deliberately drawn
    // with nothing else - no phi, no V°, no edges.
    const diagram = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-container',
        { electron: SPECIES.electron },
        { margins: { right: 46 } }
    );
    diagram.setSpatialLayout([0, 1], [{ ...REGION.metal, name: 'Metal wire' }]);
    diagram.setVRange(0.1, 0.9);

    function update(j) {
        document.getElementById('{{idprefix}}-j-readout').textContent =
            j.toFixed(1);
        diagram.updateTraceData([
            {
                id: 've',
                speciesId: 'electron',
                curveType: 'voltage',
                x: [0, 1],
                y: [0.5 + 0.25 * j, 0.5 - 0.25 * j],
            },
        ]);
    }
    makeSlider('{{idprefix}}-j', update);
</script>
