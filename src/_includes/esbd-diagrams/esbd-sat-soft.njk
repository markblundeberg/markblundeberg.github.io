{% set idprefix = "esbd-sat-soft" %}
{% import "macros/controls.njk" as controls %}
<div style="display: flex; flex-wrap: wrap; justify-content: space-evenly; gap: 8px">
<div style="flex: 1; min-width: 250px; max-width: 330px">
<div style="text-align: center; font-size: 0.85em">FET channel</div>
<div class="bd-container" id="{{idprefix}}-fet" style="height: 250px; border: 1px solid #eee"></div>
<div class="bd-container" id="{{idprefix}}-fet-conc" style="height: 100px; border: 1px solid #eee; border-top: none"></div>
</div>
<div style="flex: 1; min-width: 250px; max-width: 330px">
<div style="text-align: center; font-size: 0.85em">binary electrolyte</div>
<div class="bd-container" id="{{idprefix}}-bin" style="height: 250px; border: 1px solid #eee"></div>
<div class="bd-container" id="{{idprefix}}-bin-conc" style="height: 100px; border: 1px solid #eee; border-top: none"></div>
</div>
</div>
{{ controls.slider(idprefix + "-a", "Drive $j/j_{\\mathrm{lim}}$", { min: 0, max: 1, step: "any", value: 0.5, snap: 1, readout: true }) }}

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import XYPlot from '{{ esbdJsPath }}XYPlot.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, linspace } from '{{ esbdJsPath }}utils.js';

    // Soft pinning, side by side, one shared drive slider. No spectator sea:
    // the pinning rail (gate / counter-anion) holds the ladder only softly,
    // so V°_i slopes along with the active V_i. Electrolyte: linear c(x),
    // ladder bends 1×, active carrier 2× (ambipolar factor for the 1:1
    // binary). FET: honest long-channel charge-control model (constants
    // below) — its strip and steepening now genuinely differ from the twin.
    // At a = 1 the active carrier dives at the boundary in both panels; the
    // electrolyte's ladder dives too, but the FET's lands on a gate ceiling.
    const DEC = 0.05916;
    const VT = DEC / Math.LN10; // kT/e = 25.7 mV
    // FET model (charge-sheet + Boltzmann, gradual channel — the EKV/ACM
    // compact-model core). q ≡ en/(C_gate·V_T) is the normalized sheet
    // charge AND the local C_chem/C_gate ratio; charge control reads
    // (local gate overdrive) = V_T·(q + ln q). Current: I ∝ F(q_s) − F(q_d)
    // with F(q) = q²/2 + q (drift + diffusion), so I_sat ∝ F(QS) and the
    // drive fraction a inverts in closed form; the profile too:
    // F(q(ξ)) = F(QS) − ξ·[F(QS) − F(q_d)], ξ = channel fraction walked
    // from the source. Local steepening dV_e/dV° = 1 + 1/q = 1 +
    // C_gate/C_chem: ≈1 at the drift-dominated source, exactly 2 where
    // q = 1 (≈ classical pinch-off), diverging in the subthreshold tail.
    // The band edge never dives: at a = 1 it lands V_T·QS above its source
    // value, pinned to the gate once the channel is too dilute to screen.
    const QS = 8; // source-end C_chem/C_gate ≈ overdrive/V_T (≈ 0.26 V here)
    const FF = (q) => (q * q) / 2 + q;
    const XL = 0.12,
        XR = 0.88;
    const VLO = 0.05,
        VHI = 0.95;
    // refShift: anchoring Ag+/e- as drawn-true, NO3- sits ~-0.81 V from its
    // IUPAC-referenced position (true rung 1.03 in this gauge + 0.077
    // activity at 0.05 M, drawn 0.30). FET panel: no cross-species claims.
    const NO3_SHIFT = -0.81;

    const fet = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-fet',
        { electron: SPECIES.electron },
        { margins: { right: 60 } }
    );
    fet.setSpatialLayout([0, XL, XR, 1], [
        { ...REGION.semi2, name: 'Drain' },
        { ...REGION.semiconductor, name: 'channel' },
        { ...REGION.semi2, name: 'Source' },
    ]);
    fet.setVRange(VLO, VHI);

    const bin = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-bin',
        {
            electron: SPECIES.electron,
            silver: SPECIES.silver,
            nitrate: SPECIES.nitrate,
        },
        { margins: { right: 60 } }
    );
    bin.setSpatialLayout([0, XL, XR, 1], [
        { ...REGION.metal, name: 'Cathode' },
        { ...REGION.solution, name: 'binary AgNO₃' },
        { ...REGION.solution2, name: 'stirred bulk' },
    ]);
    bin.setVRange(VLO, VHI);

    // concentration strips (basictransport pattern): linear ramp for the
    // electrolyte (exact); the FET's honest profile bows √-like above it
    const concPanel = (id) =>
        new XYPlot(id, {
            xLabel: '',
            yLabel: 'conc.',
            xRange: [0, 1],
            yRange: [0, 1.15],
            xMode: 'abstract',
            yMode: 'abstract',
            margins: { top: 4, bottom: 12, left: 60, right: 60 },
        });
    const fetConc = concPanel('{{idprefix}}-fet-conc');
    const binConc = concPanel('{{idprefix}}-bin-conc');

    const xs = linspace(XL, 1, 121);
    const conc = (a) => (x) =>
        x >= XR ? 1 : Math.max(1e-12, 1 - a * (1 - (x - XL) / (XR - XL)));
    const trim = (fn) => {
        const x = [],
            y = [];
        for (const xi of xs) {
            const v = fn(xi);
            if (v >= VLO && v <= VHI) {
                x.push(xi);
                y.push(v);
            }
        }
        return { x, y };
    };

    function update(a) {
        document.getElementById('{{idprefix}}-a-readout').textContent =
            a.toFixed(2);
        const c = conc(a);
        const lg = (x) => Math.log10(c(x));

        // FET honest profile, parameterized by ξ (source→drain) with points
        // packed quadratically toward the drain, where all the action is
        const qd = Math.sqrt(1 + 2 * (1 - a) * FF(QS)) - 1;
        const fetX = [],
            fetQ = [];
        for (let i = 120; i >= 0; i--) {
            const t = i / 120;
            const xi = 1 - (1 - t) * (1 - t);
            fetX.push(XR - xi * (XR - XL));
            fetQ.push(
                Math.sqrt(1 + 2 * (FF(QS) - xi * (FF(QS) - FF(qd)))) - 1
            );
        }
        fetX.push(1); // source region: flat at the bulk charge
        fetQ.push(QS);
        const v0eF = (q) => 0.38 + VT * (QS - q);
        const veF = (q) =>
            v0eF(q) + 0.12 + DEC * Math.log10(QS / Math.max(q, 1e-300));
        const fetSeg = (fn) => {
            const x = [],
                y = [];
            for (let i = 0; i < fetX.length; i++) {
                const v = fn(fetQ[i]);
                if (v >= VLO && v <= VHI) {
                    x.push(fetX[i]);
                    y.push(v);
                }
            }
            return { x, y };
        };

        fetConc.updateTraceData([
            {
                // not the electrolyte's linear ramp: the strip bows up
                // (√-like) — thick channel needs little gradient, so the
                // slope steepens only toward the drain
                id: 'c',
                x: [...fetX],
                y: fetQ.map((q) => q / QS),
                color: SPECIES.electron.color,
                style: { lineWidth: 2 },
                label: 'c_{\\mathrm{e}^-}',
                labelFrac: 0.97,
            },
        ]);
        binConc.updateTraceData([
            {
                // binary: neutrality marches the two together
                id: 'c',
                x: [...xs],
                y: xs.map(c),
                color: SPECIES.silver.color,
                style: { lineWidth: 2 },
                label: 'c_{\\mathrm{Ag}^+}{=}c_{\\mathrm{NO_3}^-}',
                labelFrac: 0.97,
            },
        ]);

        // FET: the gate rail is flat; the channel edge (V°_e-) bends by the
        // oxide drop V_T·(QS − q), curving hardest at the drain, and the
        // electrons pull away by the extra log term — diverging UP at the
        // drain (z = −1) while the edge lands on the gate-pinned ceiling.
        const ved = Math.min(VHI, veF(qd));
        fet.updateTraceData([
            {
                id: 'gate',
                speciesId: 'electron',
                curveType: 'voltage',
                label: 'V_{\\mathrm{e}^-}\\,(\\text{gate})',
                style: { lineWidth: 1.5 },
                x: [XL, XR],
                y: [0.85, 0.85],
            },
            {
                id: 'v0e',
                speciesId: 'electron',
                curveType: 'bandEdge_C',
                labelFrac: 0.3,
                ...fetSeg(v0eF),
            },
            {
                id: 've',
                speciesId: 'electron',
                curveType: 'voltage',
                ...fetSeg(veF),
            },
            {
                id: 've_d',
                speciesId: 'electron',
                curveType: 'voltage',
                showLabel: false,
                x: [0, XL],
                y: [ved, ved],
            },
        ]);

        // binary electrolyte: flat blocked anion, ladder bends 1×, Ag+ 2×,
        // diving DOWN at the cathode; the cathode's electrons ride the
        // interface Ag+ level (reversible electrode).
        const vag = (x) => 0.623 + 2 * DEC * lg(x); // base = 0.7 - 0.077: same gap as NO3- (neutrality: c_Ag = c_NO3)
        const vagIf = Math.max(VLO, vag(XL));
        bin.updateTraceData([
            {
                id: 'v0ag',
                speciesId: 'silver',
                curveType: 'standardState',
                labelFrac: 0.3,
                ...trim((x) => 0.7 + DEC * lg(x)),
            },
            {
                id: 'vag',
                speciesId: 'silver',
                curveType: 'voltage',
                ...trim(vag),
            },
            {
                id: 'vno3',
                speciesId: 'nitrate',
                curveType: 'voltage',
                refShift: NO3_SHIFT,
                x: [XL, 1],
                y: [0.3, 0.3],
            },
            {
                // blocked anion: V flat, so its rung dives with the shared
                // depletion (gap = 0.077 + the log term; ladder stays rigid
                // with V°_Ag+ above)
                id: 'v0no3',
                speciesId: 'nitrate',
                curveType: 'standardState',
                refShift: NO3_SHIFT,
                ...trim((x) => 0.3 - 0.077 + DEC * lg(x)),
            },
            {
                id: 've_m',
                speciesId: 'electron',
                curveType: 'voltage',
                labelFrac: 0.03, // left-aligned at the trace's left end
                labelVAlign: 'bottom', // rides above the trace: survives the dive to the floor at a = 1 (Block-A #13)
                x: [0, XL],
                y: [vagIf, vagIf],
            },
        ]);
    }

    makeSlider('{{idprefix}}-a', update);
</script>
