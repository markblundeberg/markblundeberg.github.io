{% set idprefix = ["bd-basicbattery-multicell-", idsuffix] | join %}
{% import "macros/controls.njk" as controls %}
<div style="display: flex; flex-wrap: wrap; justify-content: space-evenly; gap: 8px">
<div style="flex: 1; min-width: 250px; max-width: 330px">
<div class="bd-container" id="{{ idprefix }}-energy" style="height: 260px"></div>
</div>
<div style="flex: 1; min-width: 250px; max-width: 330px">
<div class="bd-container" id="{{ idprefix }}-volts" style="height: 260px"></div>
</div>
</div>
{{ controls.slider(idprefix + "-current-slider", "Current", { min: -1, max: 1, step: "any", value: 0, readout: true, readoutInit: "equilibrium", snap: 0 }) }}

<script type="module">
    import BandDiagram from '{{ esbdJsPath }}BandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider } from '{{ esbdJsPath }}utils.js';

    const currentSlider = document.getElementById('{{ idprefix }}-current-slider');
    const currentText = document.getElementById('{{ idprefix }}-current-slider-readout');

    const cellregions = [
        [0.15, { ...REGION.collector, name: 'Anode' }],
        [0.3, { ...REGION.activeMaterial, name: 'Anode-active' }],
        [0.7, { ...REGION.solution, name: 'Electrolyte' }],
        [0.85, { ...REGION.activeMaterial, name: 'Cathode-active' }],
        [1.0, { ...REGION.collector, name: 'Cathode' }],
    ];

    const boundaries = [0.0];
    const regions = [];
    const labels = [];
    for (let cellidx = 0; cellidx < 3; cellidx++) {
        cellregions.forEach((element) => {
            const [xright, region] = element;
            boundaries.push(xright + cellidx);
            regions.push(region);
        });
        labels.push({ label: `Cell ${cellidx + 1}`, x: 0.5 + cellidx });
    }

    // Left: the raw energy picture (mu-bar view); right: species voltages.
    const energyDiagram = new BandDiagram('{{ idprefix }}-energy');
    energyDiagram.setSpatialLayout(boundaries, regions, labels);
    energyDiagram.setYLabel('Electron/ion energy (eV)');
    energyDiagram.setYRange(-11.0, +7.7);

    const voltsDiagram = new BandDiagram('{{ idprefix }}-volts');
    voltsDiagram.setSpatialLayout(boundaries, regions, labels);
    voltsDiagram.setYLabel('Species voltage (V)');
    voltsDiagram.setYRange(-1.5, +11.2);

    const R_anode = 0.03;
    const R_cathode = R_anode;
    const R_Li = 0.2;
    const OCV_anode = 0.1;
    const OCV_cathode = 3.4;

    const li_color = SPECIES.lithium.color;
    const electron_color = SPECIES.electron.color;

    function updateDiagrams() {
        const dphi = 0;
        const current = parseFloat(currentSlider.value);

        currentText.textContent =
            current > 0 ? 'discharging⇨' : current < 0 ? '⇦charging' : 'equilibrium';

        const V_left = 0.0 + dphi;
        const V_Li_left = V_left - OCV_anode;
        const V_Li_right = V_Li_left - current * R_Li;
        const V_right = V_Li_right + OCV_cathode;
        const V_anode = V_left - current * R_anode;
        const V_cathode = V_right + current * R_cathode;
        const V_cell = V_right - V_left;

        const b = boundaries;
        const voltsData = [];
        for (let cellidx = 0; cellidx < 3; cellidx++) {
            const b0 = cellregions.length * cellidx;
            const V0 = V_cell * cellidx;
            voltsData.push({
                id: 'anode_trace_' + cellidx,
                label: 'V_{\\mathrm{e}^-}',
                showLabel: false,
                color: electron_color,
                x: [b[b0 + 0], b[b0 + 1], b[b0 + 2]],
                y: [V0 + V_left, V0 + V_left, V0 + V_anode],
            });
            voltsData.push({
                id: 'li_trace_' + cellidx,
                label: 'V_{\\mathrm{Li}^+}',
                showLabel: true,
                color: li_color,
                x: [b[b0 + 1], b[b0 + 4]],
                y: [V0 + V_Li_left, V0 + V_Li_right],
            });
            voltsData.push({
                id: 'cathode_trace_' + cellidx,
                label: 'V_{\\mathrm{e}^-}',
                showLabel: cellidx == 2,
                color: electron_color,
                x: [b[b0 + 3], b[b0 + 4], b[b0 + 5]],
                y: [V0 + V_cathode, V0 + V_right, V0 + V_right],
            });
        }
        voltsDiagram.updateTraceData(voltsData);

        // Same physics, mapped back to energies: mu-bar_i = z_i V_i, so the
        // electron traces flip sign while the Li+ traces don't.
        const energyData = voltsData.map((trace) => ({
            ...trace,
            label: trace.id.startsWith('li_')
                ? '\\bar\\mu_{\\mathrm{Li}^+}'
                : '\\bar\\mu_{\\mathrm{e}^-}',
            y: trace.y.map((v) => (trace.id.startsWith('li_') ? v : -v)),
        }));
        energyDiagram.updateTraceData(energyData);
    }

    makeSlider('{{ idprefix }}-current-slider', () => updateDiagrams(), { fire: false });
    updateDiagrams();
</script>
