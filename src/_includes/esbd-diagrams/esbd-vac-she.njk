{% set idprefix = "esbd-vac-she" %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 300px"></div>

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';

    // Static: the "absolute" electrode potential drawn as what it is — a gap.
    // The outer potential just above a standard hydrogen electrode's solution
    // sits 4.44 V below the SHE rung V°_e-(SHE) on the voltage axis (Farrell &
    // McTigue via Trasatti), exactly as a work function sits below a metal's
    // V_e-. Deliberately NOT drawn at V°_e-(SHE) = 0: the global float is
    // free, and the vacuum is one more floating level, not a universal zero.
    // And deliberately NOT drawn flat: real vacuum levels tilt (stray fields,
    // patchy contaminated surfaces); only careful compensation experiments
    // iron them out. The 4.44 V gap is read just outside the surface.
    const VSHE = 0.15; // floated off zero on purpose
    const WSHE = 4.44;
    const phiVac = (x) => {
        const t = (x - 0.55) / 0.45; // 0 at the surface, 1 at the far edge
        return VSHE - WSHE - 0.18 * t - 0.17 * t * t;
    };
    const vacXs = [0.55, 0.66, 0.77, 0.89, 1.0];

    const diagram = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-container',
        { electron: SPECIES.electron },
        { margins: { right: 46, left: 46 } }
    );
    diagram.setSpatialLayout([0, 0.55, 1], [
        { ...REGION.solution, name: 'SHE solution' },
        REGION.vacuum,
    ]);
    diagram.setVRange(-4.75, 0.7);

    diagram.updateTraceData([
        {
            id: 'vshe',
            speciesId: 'electron',
            curveType: 'standardStateImplied',
            label: 'V^\\circ_{\\mathrm{e}^-}(\\mathrm{SHE})',
            labelFrac: 0.42,
            x: [0, 0.55],
            y: [VSHE, VSHE],
        },
        {
            id: 'phivac',
            speciesId: 'electron',
            curveType: 'phi',
            label: '\\phi_{\\mathrm{vac}}',
            labelFrac: 0.6,
            x: [...vacXs],
            y: vacXs.map(phiVac),
        },
        // dotted guide carrying the SHE rung to the marker's x, so the
        // marker's top dot doesn't hang in empty vacuum (vac-rungs idiom)
        {
            id: 'guideShe',
            speciesId: 'electron',
            curveType: 'standardStateImplied',
            style: { lineWidth: 1, dasharray: '1.5,3' },
            showLabel: false,
            x: [0.55, 0.65],
            y: [VSHE, VSHE],
        },
    ]);

    diagram.updateVerticalMarkers([
        {
            id: 'wshe',
            x: 0.62,
            yDefs: [{ y: VSHE }, { y: phiVac(0.62) }],
            symbol: '↕',
            label: '4.44\\ \\mathrm{V}',
            labelHAlign: 'left', // extends rightward, into open vacuum
            popupCallback: () =>
                'the widely-quoted "absolute" SHE potential, ≈ 4.44 V: an electrode work function — a per-surface quantity, not a universal zero',
        },
    ]);
</script>
