{% set idprefix = "esbd-cap-family" %}
{% import "macros/controls.njk" as controls %}
<div style="display: flex; flex-wrap: wrap; justify-content: space-evenly; gap: 6px">
<div style="flex: 1; min-width: 180px; max-width: 240px">
<div style="text-align: center; font-size: 0.85em">dielectric</div>
<div class="bd-container" id="{{idprefix}}-mim" style="height: 230px; border: 1px solid #eee"></div>
</div>
<div style="flex: 1; min-width: 180px; max-width: 240px">
<div style="text-align: center; font-size: 0.85em">electrolytic</div>
<div class="bd-container" id="{{idprefix}}-lytic" style="height: 230px; border: 1px solid #eee"></div>
</div>
</div>
{{ controls.slider(idprefix + "-v", "Applied voltage", { min: -1, max: 1, step: "any", value: 0.7, snap: 0, readout: true, unit: "V" }) }}

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, linspace } from '{{ esbdJsPath }}utils.js';

    // Dielectric capacitance two ways: the full applied voltage falls across
    // the gap (MIM) or a thin oxide film (electrolytic; one plate is an ion
    // rail). The bare-interface double layer got its own figure,
    // esbd-cap-edl.njk. phi drawn only where nothing screens, stepping down
    // from each metal's V_e- by a work function (0.25 V here, schematic).
    // The MIM panel's phi runs flat at zero bias (symmetric metals,
    // deliberate); the electrolytic panel keeps a small built-in step DPHI0
    // even at v = 0, since its two sides are different materials and their
    // surfaces have no reason to line up (Mark's pet peeve, 2026-07-15).
    // phi sits at an arbitrary display height and must MEET NOTHING: WFD is
    // drawn big and the V levels are lifted so phi's endpoints stay visibly
    // clear of every V_i and rung while everything fits the shared range.
    const WFD = 0.55; // schematic phi offset below its metal's V_e- (arbitrary; real WF is 4-5 V)
    const LIFT = 0.2; // lift all V levels to keep the dropped phi in range
    const DPHI0 = 0.12; // electrolytic: built-in phi step at zero bias
    // The wet panels apply the bias between two METALS (we control V_e-
    // differences, not V_e- vs V_Na+ directly — Mark 2026-07-10): a sliver
    // of counter-electrode on the right, whose ion couples to it at a
    // fixed offset BELOW its V_e- (V_Na+ = V_e- would mean sodium-plating
    // levels of reduction — not in water).
    const OFF = 0.35;
    // abstract y (Mark, 2026-07-10): the three repeated numeric axes were
    // clutter, and the only number worth reading — the applied voltage —
    // lives in the slider readout. Also stops the compressed work-function
    // step from being read off as Phi/e = 0.25 V.
    // slim right margin: all labels sit inside the plots (kept identical
    // across the three panels so their plot widths match)
    const common = { yMode: 'abstract', margins: { right: 12, left: 42 } };

    const mim = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-mim',
        { electron: SPECIES.electron },
        common
    );
    mim.diagram.setYLabel('Species voltage');
    mim.setSpatialLayout([0, 0.3, 0.7, 1], [
        { ...REGION.metal, name: '' },
        { ...REGION.vacuum, name: 'dielectric' },
        { ...REGION.metal, name: '' },
    ]);
    mim.setVRange(-1.05, 1.05);

    const lytic = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-lytic',
        { electron: SPECIES.electron, ion: SPECIES.sodium },
        common
    );
    lytic.diagram.setYLabel(''); // one axis label (left panel) serves all three
    lytic.setSpatialLayout([0, 0.32, 0.44, 0.88, 1], [
        REGION.metal,
        { ...REGION.vacuum, name: '' }, // (the thin oxide; labeled in caption)
        REGION.solution,
        { ...REGION.metal, name: '' }, // counter-electrode sliver
    ]);
    lytic.setVRange(-1.05, 1.05);

    function update(v) {
        document.getElementById('{{idprefix}}-v-readout').textContent =
            v.toFixed(2);
        const vp = v / 2,
            vm = -v / 2;

        mim.updateTraceData([
            {
                id: 'vel',
                speciesId: 'electron',
                curveType: 'voltage',
                labelFrac: 0.4,
                x: [0, 0.3],
                y: [vp + LIFT, vp + LIFT],
            },
            {
                id: 'phi',
                speciesId: 'electron',
                curveType: 'phi',
                label: '\\phi',
                labelFrac: 0.5,
                x: [0.3, 0.7],
                y: [vp + LIFT - WFD, vm + LIFT - WFD],
            },
            {
                id: 'ver',
                speciesId: 'electron',
                curveType: 'voltage',
                showLabel: false,
                x: [0.7, 1],
                y: [vm + LIFT, vm + LIFT],
            },
        ]);

        lytic.updateTraceData([
            {
                id: 'vel',
                speciesId: 'electron',
                curveType: 'voltage',
                labelFrac: 0.4,
                x: [0, 0.32],
                y: [vp + LIFT, vp + LIFT],
            },
            {
                id: 'phi',
                speciesId: 'electron',
                curveType: 'phi',
                label: '\\phi',
                labelFrac: 0.5,
                x: [0.32, 0.44],
                y: [vp + LIFT - WFD, vm + LIFT - WFD - DPHI0],
            },
            {
                id: 'vion',
                speciesId: 'ion',
                curveType: 'voltage',
                labelFrac: 0.5,
                x: [0.44, 0.88],
                y: [vm + LIFT - OFF, vm + LIFT - OFF],
            },
            {
                id: 'vel_r',
                speciesId: 'electron',
                curveType: 'voltage',
                showLabel: false,
                x: [0.88, 1],
                y: [vm + LIFT, vm + LIFT],
            },
        ]);
    }
    makeSlider('{{idprefix}}-v', update);
</script>
