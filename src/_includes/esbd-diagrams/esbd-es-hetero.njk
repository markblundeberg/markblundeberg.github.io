{% set idprefix = "esbd-es-hetero" %}
{% import "macros/controls.njk" as controls %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 280px"></div>
<div class="bd-container" id="{{idprefix}}-rho" style="height: 110px"></div>
<div style="display: grid; grid-template-columns: max-content minmax(0, 180px); gap: 2px 10px; justify-content: center; align-items: center; margin-top: 0.4em">
{{ controls.slider(idprefix + "-na", "doping A ($\\log_{10} n$)", { min: 15, max: 17.5, step: "any", value: 16, inline: true, readout: true }) }}
{{ controls.slider(idprefix + "-nb", "doping B ($\\log_{10} n$)", { min: 15, max: 17.5, step: "any", value: 15, inline: true, readout: true }) }}
</div>

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import XYPlot from '{{ esbdJsPath }}XYPlot.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider } from '{{ esbdJsPath }}utils.js';

    // Heterojunction between two n-type semiconductors, at equilibrium.
    // The conduction-edge offset right AT the contact is a fixed property of
    // the atomic interface (DALIGN, never moves). Each bulk's edge sits
    // xi = DEC·(logNC − logn) below the shared flat Fermi level; band
    // bending absorbs the mismatch between that and the fixed alignment.
    //
    // Drawn from the real majority-carrier Poisson–Boltzmann profile, not a
    // linearized cartoon. With u = ψ/V_T (edge shift from bulk, in thermal
    // units), n = N·e^u and ρ = eN(1 − e^u); the first integral of Poisson
    // gives |dψ/dx| = (V_T/λ_D)·√2·G(u), G(u) = √(e^u − u − 1), so each
    // side is a pure quadrature — no shooting. The interface split of the
    // total bending solves field continuity √N_A·G(u_A) = √N_B·G(u_B)
    // (equal ε, no interface charge) by bisection; with this DALIGN sign,
    // side A always depletes (u_A < 0) and side B accumulates (u_B > 0).
    // Depletion emerges as the textbook boxcar: ρ flat at +eN over
    // W ≈ λ_D·√(2|u_A|), Debye-rounded tail, parabolic edge bending.
    // Accumulation emerges as a thin spike of pile-up electrons, peak
    // eN_B(e^{u_B} − 1), which honestly exits the ρ frame (clipTraces):
    // its area still cancels the boxcar's exactly. Crank one doping to the
    // max and that side goes metal-like: rigid edge, near-sheet charge.
    const DEC = 0.05916;
    const VT = DEC / Math.LN10;
    const VF = 0.55; // flat Fermi level
    const DALIGN = 0.25; // fixed interfacial edge offset (B above A)
    const LOGNC = 19.45;
    const xi = (logn) => DEC * (LOGNC - logn);
    // Debye length in panel units, ∝ 1/√n, unclamped; the prefactor sizes
    // the worst-case boxcar (weak side deeply depleted, W ≈ 3.9·λ) to fit
    // its half-panel
    const lam = (logn) => 0.091 * Math.pow(10, -(logn - 15) / 2);
    const G = (u) => Math.sqrt(Math.max(0, Math.exp(Math.min(u, 40)) - u - 1));

    const diagram = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-container',
        { electron: SPECIES.electron },
        { margins: { right: 64 } }
    );
    diagram.setSpatialLayout([0, 0.5, 1], [
        { ...REGION.semi2, name: 'Semiconductor A' },
        { ...REGION.semiconductor, name: 'Semiconductor B' },
    ]);
    diagram.setVRange(0.02, 0.75);

    // charge panel: the contact's double layer, true shapes and relative
    // magnitudes, normalized to the depletion boxcar's height. The
    // accumulation spike runs off the bottom of the frame by design.
    const rho = new XYPlot('{{idprefix}}-rho', {
        xLabel: '',
        yLabel: 'Charge density',
        xRange: [0, 1],
        yRange: [-2.6, 1.3],
        xMode: 'abstract',
        yMode: 'abstract',
        clipTraces: true,
        // left/right match the band diagram above so the contact lines up
        margins: { top: 4, bottom: 12, left: 60, right: 64 },
    });

    // fixed spatial grid of distances from the contact, geometrically
    // packed toward it: every update lands on the SAME x points, so the
    // d3 trace tweens stay coherent under slider motion (a per-update
    // quadrature grid pairs unrelated points and glitches)
    const NG = 120;
    const DGRID = [];
    for (let k = 0; k <= NG; k++)
        DGRID.push(
            (0.5 * (Math.pow(1.05, k) - 1)) / (Math.pow(1.05, NG) - 1)
        );
    const XGA = DGRID.map((d) => 0.5 - d).reverse(); // ascending, 0 → 0.5
    const XGB = DGRID.map((d) => 0.5 + d); // ascending, 0.5 → 1

    // march from the contact into a bulk by quadrature on the first
    // integral, dx = λ·|du|/(√2·G); log-spaced u resolves the sharp knee
    // and the long tail alike. Returns distance-from-contact profile.
    // ucut: where to declare the tail settled — must scale with 1/N, since
    // the residual CHARGE N·u is what has to be negligible, not u itself
    // (a heavily doped side still carries visible ρ at tiny bendings).
    const profile = (uIf, lamS, ucut) => {
        const dArr = [0],
            uArr = [uIf];
        let d = 0;
        let uPrev = uIf;
        const NPT = 140;
        for (let i = 1; i <= NPT; i++) {
            const u = uIf * Math.pow(ucut / Math.abs(uIf), i / NPT);
            const step =
                (lamS * Math.abs(uPrev - u) * (1 / G(uPrev) + 1 / G(u))) /
                (2 * Math.SQRT2);
            if (d + step >= 0.5) {
                // frame edge arrives mid-transition: interpolate and stop
                uArr.push(uPrev + ((u - uPrev) * (0.5 - d)) / step);
                dArr.push(0.5);
                return { d: dArr, u: uArr };
            }
            d += step;
            uPrev = u;
            dArr.push(d);
            uArr.push(u);
        }
        dArr.push(0.5); // settled: flat bulk to the frame edge
        uArr.push(0);
        return { d: dArr, u: uArr };
    };

    // resample a profile's u onto DGRID (both sorted: one forward pass)
    const sample = (prof) => {
        const out = [];
        let j = 0;
        for (const d of DGRID) {
            while (j < prof.d.length - 2 && prof.d[j + 1] < d) j++;
            const d0 = prof.d[j],
                d1 = prof.d[j + 1];
            const f =
                d1 > d0 ? Math.min(1, Math.max(0, (d - d0) / (d1 - d0))) : 0;
            out.push(prof.u[j] + (prof.u[j + 1] - prof.u[j]) * f);
        }
        return out;
    };

    function update() {
        const lognA = parseFloat(naEl.value);
        const lognB = parseFloat(nbEl.value);
        const eAb = VF - xi(lognA);
        const eBb = VF - xi(lognB);
        const NA = Math.pow(10, lognA - 15);
        const NB = Math.pow(10, lognB - 15);
        const lA = lam(lognA),
            lB = lam(lognB);

        // total bending in thermal units, then the field-continuity split:
        // h(u_A) is monotone, so bisect u_A in (−du, 0)
        const du = -(eBb - eAb - DALIGN) / VT;
        let lo = -du,
            hi = 0;
        for (let i = 0; i < 60; i++) {
            const mid = (lo + hi) / 2;
            if (Math.sqrt(NB) * G(mid + du) - Math.sqrt(NA) * G(mid) > 0)
                hi = mid;
            else lo = mid;
        }
        const uA = (lo + hi) / 2;
        const uB = uA + du;

        const norm = NA * (1 - Math.exp(uA)); // the boxcar's height
        const ucut = (N) =>
            Math.min(0.004, Math.max(1e-6, (0.002 * norm) / N));
        const uAs = sample(profile(uA, lA, ucut(NA))).reverse(); // matches XGA
        const uBs = sample(profile(uB, lB, ucut(NB))); // matches XGB

        rho.updateTraceData([
            {
                id: 'zero',
                x: [0, 1],
                y: [0, 0],
                color: '#bbb',
                style: { lineWidth: 1 },
                showLabel: false,
            },
            {
                id: 'dl',
                x: [...XGA, ...XGB],
                y: [
                    ...uAs.map((u) => (NA * (1 - Math.exp(u))) / norm),
                    ...uBs.map((u) => (NB * (1 - Math.exp(u))) / norm),
                ],
                color: '#7a5fb5',
                style: { lineWidth: 2 },
                showLabel: false,
            },
        ]);

        diagram.updateTraceData([
            {
                id: 've',
                speciesId: 'electron',
                curveType: 'voltage',
                x: [0, 1],
                y: [VF, VF],
            },
            {
                id: 'edgeA',
                speciesId: 'electron',
                curveType: 'bandEdge_C',
                label: 'V^\\circ_{\\mathrm{e}^-}(\\mathrm{A})',
                labelFrac: 0.06,
                x: [...XGA],
                y: uAs.map((u) => eAb + VT * u),
            },
            {
                id: 'edgeB',
                speciesId: 'electron',
                curveType: 'bandEdge_C',
                label: 'V^\\circ_{\\mathrm{e}^-}(\\mathrm{B})',
                x: [...XGB],
                y: uBs.map((u) => eBb + VT * u),
            },
        ]);

        // the one thing that never moves: the edge gap right at the contact
        diagram.updateVerticalMarkers([
            {
                id: 'align',
                x: 0.5,
                yDefs: [{ y: eAb + VT * uA }, { y: eBb + VT * uB }],
                symbol: '↕',
                popupCallback: () =>
                    'the interfacial alignment: a fixed property of the atomic contact, independent of the dopings',
            },
        ]);

        document.getElementById('{{idprefix}}-na-readout').textContent =
            lognA.toFixed(1);
        document.getElementById('{{idprefix}}-nb-readout').textContent =
            lognB.toFixed(1);
    }

    const naEl = makeSlider('{{idprefix}}-na', update, { fire: false });
    const nbEl = makeSlider('{{idprefix}}-nb', update, { fire: false });
    update();
</script>
