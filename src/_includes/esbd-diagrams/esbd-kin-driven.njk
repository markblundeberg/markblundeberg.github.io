{% set idprefix = "esbd-kin-driven" %}
{% import "macros/controls.njk" as controls %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 280px"></div>
{{ controls.slider(idprefix + "-j", "Current (anodic +)", { min: -3, max: 3, step: "any", value: 1.8, snap: 0, readout: true }) }}

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, linspace } from '{{ esbdJsPath }}utils.js';

    // One driven electrode, schematically (current j in units of ~J0),
    // using the same spatial vocabulary as the concpol/saturation figures:
    // - charge-transfer step at the interface: eta = 0.08·asinh(j) (BV-ish)
    // - unstirred layer: linear c(x), so the activity term bends the
    //   reaction level logarithmically while the (supported) ladder stays
    //   flat there
    // - stirred bulk: uniform c, everything tilts together ohmically.
    // At j = 0 all of it flattens back to equilibrium. Magnitudes are
    // cartoon-sized for legibility, not computed from a real cell.
    const DEC = 0.05916;
    const XIF = 0.25,
        XB = 0.6; // electrode | unstirred layer | stirred bulk
    const V_ELEC = 0.6; // fixed electrode level — the controlled quantity we anchor to
    const V_BULK = 0.5; // bulk reaction level, pre-shift reference for the profile
    const ACT = 0.18; // bulk activity gap V_rxn − V°_rxn
    const V_SHE = 0.2; // local SHE reference rung, pre-shift (rides the ladder)
    const R_OHM = 0.035,
        ETA0 = 0.08;

    const diagram = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-container',
        { electron: SPECIES.electron },
        { margins: { right: 104 } }
    );
    diagram.setSpatialLayout([0, XIF, XB, 1], [
        { ...REGION.metal, name: 'Electrode' },
        { ...REGION.solution, name: 'unstirred layer' },
        { ...REGION.solution2, name: 'stirred bulk' },
    ]);
    diagram.setVRange(0.0, 1.05);

    const xs = linspace(XIF, 1, 91);

    function update(j) {
        document.getElementById('{{idprefix}}-j-readout').textContent =
            j.toFixed(1);
        const merged = Math.abs(j) < 0.1;

        // Ox accumulates and Red depletes linearly across the unstirred
        // layer under anodic current (and vice versa), capped short of dry;
        // the couple's activity RATIO polarizes from both sides
        const c = (x) =>
            x >= XB ? 1 : 1 + 0.3 * j * (1 - (x - XIF) / (XB - XIF));
        const conc = (x) => DEC * Math.log10(c(x) / (2 - c(x)));
        const tilt = (x) => R_OHM * j * (1 - Math.max(x, XB));
        const eta = ETA0 * Math.asinh(j);
        // Anchor the ELECTRODE level (the quantity you actually set), not the
        // arbitrary right edge of the plot: the metal sits at a fixed V_ELEC,
        // the interface reaction level is eta away from it, and the whole
        // solution profile floats off that — so V°_e- at the right limit
        // moves with the current instead of being pinned there.
        const shift = V_ELEC - eta - (V_BULK + conc(XIF) + tilt(XIF));
        const vRxn = (x) => V_BULK + conc(x) + tilt(x) + shift;
        const vStd = (x) => V_BULK - ACT + tilt(x) + shift;
        const vMetal = V_ELEC;

        diagram.updateTraceData([
            {
                id: 'metal',
                speciesId: 'electron',
                curveType: 'voltage',
                labelFrac: 0.35, // label stays at equilibrium too (Block-A #16); mid-metal, clear of the rxn label
                x: [0, XIF],
                y: [vMetal, vMetal],
            },
            {
                id: 'rxn',
                speciesId: 'electron',
                curveType: 'voltageImplied',
                label: 'V_{\\mathrm{e}^-}(\\mathrm{Ox}/\\mathrm{Red})',
                x: xs,
                y: xs.map(vRxn),
            },
            {
                id: 'rxn_std',
                speciesId: 'electron',
                curveType: 'standardStateImplied',
                label: 'V^\\circ_{\\mathrm{e}^-}(\\mathrm{Ox}/\\mathrm{Red})',
                x: xs,
                y: xs.map(vStd),
            },
            {
                // the local SHE reference rung rides the ladder (flat through
                // the supported layer, ohmic tilt in the bulk): the electrode
                // potential "vs SHE" is the V_e-(metal) ↔ this-line gap
                id: 'she_std',
                speciesId: 'electron',
                curveType: 'standardStateImplied',
                label: 'V^\\circ_{\\mathrm{e}^-}(\\mathrm{SHE})',
                x: xs,
                y: xs.map((x) => V_SHE + tilt(x) + shift),
            },
        ]);

        // driven marker, single-species flavour (Mark 2026-07-10): the
        // implied-level representation hides the chemistry, so this is
        // just an electron hop V_e- -> V_e- — a bare current arrow, no ⇌
        // bubble (the arrow replaces it). Fades out at j = 0: the levels
        // merging IS the equilibrium statement. The ghost dot rides the
        // IMPLIED line: V_e-(Ox/Red) is, logically, a whole line of ghost
        // dots — the electron rail's equilibrium position given the ions —
        // and the marker's ghost is just the one at the interface.
        diagram.updateVerticalMarkers([
            {
                id: 'ct',
                x: XIF,
                yDefs: [{ y: vRxn(XIF) }],
                symbol: null,
                driven: { y: vMetal, color: SPECIES.electron.color },
                popupCallback: () =>
                    'the reaction overpotential $\\eta$: conventional current hops down, driven by $\\mathrm{Ox} + \\mathrm{e}^- \\rightleftharpoons \\mathrm{Red}$ running net-forward',
            },
        ]);
    }

    makeSlider('{{idprefix}}-j', update);
</script>
