{% set idprefix = "esbd-tb-concpol" %}
{% import "macros/controls.njk" as controls %}
<div class="bd-container" id="{{idprefix}}-band" style="height: 260px"></div>
{{ controls.slider(idprefix + "-j", "Current", { min: -1, max: 1, step: "any", value: 0.6, snap: 0, readout: true }) }}
<div style="text-align: center">{{ controls.checkbox(idprefix + "-sup", "add supporting electrolyte") }}</div>

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, linspace } from '{{ esbdJsPath }}utils.js';

    // Concentration polarization, kept deliberately shallow (saturation digs
    // deeper with the same chemistry). A silver cathode plates Ag+ out of
    // binary AgNO3; the anion is blocked. Three zones:
    //  - unstirred layer: linear c(x); the blocked NO3- is EXACTLY flat
    //    (zero current => zero slope), the ladder bends as DEC*log c, and
    //    Ag+ bends twice that (binary factor).
    //  - stirred bulk: uniform c carrying the current ohmically - every
    //    level tilts together.
    //  - supporting electrolyte: the ladder pins flat in the layer AND the
    //    bulk tilt is suppressed (Newman ch19 §19.5's point).
    // Depletion capped well short of running dry - no j_lim here.
    const DEC = 0.05916;
    const XIF = 0.25,
        XB = 0.6; // electrode | layer | bulk boundaries
    const V_X = 0.38; // blocked anion, flat (base)
    const V0X_B = 0.303,
        V0AG_B = 0.68; // rungs (compressed; NO3- group flagged below)
    const GAP_AG = 0.077; // bulk V°_Ag - V_Ag (0.05 M)
    const ROHM = 0.25; // bulk ohmic tilt per unit current
    // refShift: anchoring Ag+/e- as drawn-true, the NO3- group sits
    // ~0.303 - 1.01 = -0.71 V from its IUPAC-referenced position
    const NO3_SHIFT = -0.71;

    const band = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-band',
        { silver: SPECIES.silver, nitrate: SPECIES.nitrate, electron: SPECIES.electron },
        { margins: { right: 56 } }
    );
    band.setSpatialLayout([0, XIF, XB, 1], [
        { ...REGION.metal, name: 'Ag cathode' },
        { ...REGION.solution, name: 'unstirred layer' },
        { ...REGION.solution2, name: 'stirred bulk' },
    ]);
    band.setVRange(0.1, 0.95);

    const xs = linspace(XIF, 1, 91);

    function update() {
        const j = parseFloat(jEl.value);
        const sup = supEl.checked;
        document.getElementById('{{idprefix}}-j-readout').textContent =
            j.toFixed(1);

        // c/c_bulk: linear across the layer, uniform (stirred) beyond
        const c = (x) =>
            x >= XB ? 1 : 1 - 0.9 * j * (1 - (x - XIF) / (XB - XIF));
        const bend = (x) => DEC * Math.log10(c(x));
        // ohmic tilt of everything in the stirred bulk (suppressed by support)
        const ohm = (x) => (sup ? 0 : ROHM * j * Math.max(0, x - XB));

        const vAg = (x) => V0AG_B - GAP_AG + (sup ? 1 : 2) * bend(x) + ohm(x);
        const vAgIf = vAg(XIF);

        band.updateTraceData([
            {
                id: 've_m',
                speciesId: 'electron',
                curveType: 'voltage',
                labelFrac: 0.4,
                x: [0, XIF],
                y: [vAgIf, vAgIf],
            },
            {
                id: 'v0ag',
                speciesId: 'silver',
                curveType: 'standardState',
                x: xs,
                y: xs.map((x) => V0AG_B + (sup ? 0 : bend(x)) + ohm(x)),
            },
            {
                id: 'vag',
                speciesId: 'silver',
                curveType: 'voltage',
                x: xs,
                y: xs.map(vAg),
            },
            {
                id: 'v0x',
                speciesId: 'nitrate',
                curveType: 'standardState',
                refShift: NO3_SHIFT,
                x: xs,
                y: xs.map((x) => V0X_B + (sup ? 0 : bend(x)) + ohm(x)),
            },
            {
                id: 'vx',
                speciesId: 'nitrate',
                curveType: 'voltage',
                refShift: NO3_SHIFT,
                labelFrac: 1,
                x: xs,
                y: xs.map((x) => V_X + ohm(x)), // flat in the layer - the point
            },
        ]);
    }

    const jEl = makeSlider('{{idprefix}}-j', update, { fire: false });
    const supEl = document.getElementById('{{idprefix}}-sup');
    supEl.addEventListener('change', update);
    update();
</script>
