{% set idprefix = "esbd-tb-ljp" %}
{% import "macros/controls.njk" as controls %}
<div class="bd-container" id="{{idprefix}}-container" style="height: 260px"></div>
{{ controls.slider(idprefix + "-mob", "$\\log_{10}(D_+/D_-)$", { min: -1.5, max: 1.5, step: "any", value: 0.9, snap: 0, readout: true }) }}
<div style="text-align: center; font-size: 0.85em; margin-top: 0.2em"><span id="{{idprefix}}-ljp"></span></div>

<script type="module">
    import ElectrochemicalSpeciesBandDiagram from '{{ esbdJsPath }}ElectrochemicalSpeciesBandDiagram.js';
    import { SPECIES, REGION } from '{{ esbdJsPath }}figureDefs.js';
    import { makeSlider, renderSpanMath, linspace } from '{{ esbdJsPath }}utils.js';

    // Steady liquid junction between concentrated (left, 0.1 M) and dilute
    // (right, 1 mM) solutions of one 1:1 salt. Analytic profiles (constant
    // t±): steady state + neutrality force equal ion fluxes = ambipolar
    // diffusion with constant D, so c(x) is LINEAR across the zone; then
    // dφ = −(t+−t−)(RT/F) d ln c stacks with the activity terms to give
    //   V+(x) = V+L + 2 t− (RT/F) ln[c(x)/c_L],
    //   V−(x) = V−L − 2 t+ (RT/F) ln[c(x)/c_L],
    //   ladder(x): −(t+−t−)(RT/F) ln[c(x)/c_L]  → LJP end to end.
    // Slope-ratio invariant: dV+/dx : dV−/dx = −t−/t+ everywhere in the
    // zone (flux check: c·D+·2t−·c'/c = const, and D+t− = D−t+). Curvature
    // hugs the dilute end. Slider = mobility ratio; at D+ = D− the LJP
    // vanishes; default +0.9 (t+ ≈ 0.89) makes a strong cation-led
    // junction. Ions are a GENERIC M+/X− salt (round-2 X-8: this used to
    // wear an NaCl costume while drawing D+ > D−, but real NaCl has the
    // ANION faster — every asymmetry was backwards for the named salt).
    // Rungs compressed. Both V°_i rungs drawn, honest per species:
    // V°_+ = V_+ + gap(x), V°_− = V_− − gap(x) with
    // gap(x) = −DEC·log10 c(x) (c_L = 0.1 M);
    // both reduce to anchor − (t+−t−)·DEC·ln-c ramp = the rigid ladder.
    const DEC = 0.05916;
    const DLOGC = -2; // log10(c_R/c_L)
    const LOGCL = -1; // log10(c_L): 0.1 M on the concentrated side
    const MID = 0.5;
    const GAP_R = 0.15; // V+/V− splitting at the dilute end (compressed)
    // refShift: any real salt's rungs sit volts apart; anchoring M+ as
    // drawn-true, the X− traces carry a generic NaCl-scale shift (the
    // x-dependence of the splitting is honest; only the base is shifted).
    const X_SHIFT = -4.58;

    const diagram = new ElectrochemicalSpeciesBandDiagram(
        '{{idprefix}}-container',
        {
            cation: { ...SPECIES.sodium, mathLabel: '\\mathrm{M}^{+}' },
            anion: { ...SPECIES.chloride, mathLabel: '\\mathrm{X}^{-}' },
        },
        { margins: { right: 56 } }
    );
    diagram.setSpatialLayout([0, 0.35, 0.65, 1], [
        { ...REGION.solution2, name: 'concentrated' },
        { name: 'junction', color: '#f0f5ec' },
        { ...REGION.solution, name: 'dilute' },
    ]);
    diagram.setVRange(0.1, 0.95);

    const xs = linspace(0, 1, 161);
    const clamp01 = (t) => (t <= 0 ? 0 : t >= 1 ? 1 : t);
    // linear salt profile across the junction zone, uniform in the bulks
    const CRATIO = Math.pow(10, DLOGC); // c_R/c_L = 0.01
    const crel = (x) => 1 + (CRATIO - 1) * clamp01((x - 0.35) / 0.3); // c/c_L
    const lgrel = (x) => Math.log10(crel(x));

    function update(r) {
        const tp = Math.pow(10, r) / (Math.pow(10, r) + 1);
        const tm = 1 - tp;
        const ljp = -(tp - tm) * DEC * DLOGC; // volts, end to end
        const GAP_L = GAP_R - 2 * DEC * DLOGC; // splitting at the conc. end
        const VPL = MID + GAP_L / 2,
            VML = MID - GAP_L / 2; // left-bulk levels

        // rung gap to each carrier reads the local concentration
        const gap = (x) => -DEC * (LOGCL + lgrel(x));

        diagram.updateTraceData([
            {
                id: 'vp',
                speciesId: 'cation',
                curveType: 'voltage',
                x: [...xs],
                y: xs.map((x) => VPL + 2 * tm * DEC * lgrel(x)),
            },
            {
                id: 'v0p',
                speciesId: 'cation',
                curveType: 'standardState',
                x: [...xs],
                y: xs.map(
                    (x) => VPL + 2 * tm * DEC * lgrel(x) + gap(x)
                ),
            },
            {
                id: 'vm',
                speciesId: 'anion',
                refShift: X_SHIFT,
                curveType: 'voltage',
                x: [...xs],
                y: xs.map((x) => VML - 2 * tp * DEC * lgrel(x)),
            },
            {
                id: 'v0m',
                speciesId: 'anion',
                refShift: X_SHIFT,
                curveType: 'standardState',
                x: [...xs],
                y: xs.map(
                    (x) => VML - 2 * tp * DEC * lgrel(x) - gap(x)
                ),
            },
        ]);

        renderSpanMath(
            document.getElementById('{{idprefix}}-ljp'),
            `\\text{LJP} = ${(1000 * ljp).toFixed(0)}\\,\\mathrm{mV}`
        );
        document.getElementById('{{idprefix}}-mob-readout').textContent =
            r.toFixed(1);
    }

    makeSlider('{{idprefix}}-mob', update);
</script>
