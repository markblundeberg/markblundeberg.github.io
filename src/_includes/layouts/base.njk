<!DOCTYPE html>
<html lang="en" class="no-js">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        {# Title/description from front matter, falling back to the per-topic
           table in _data/esbdMeta.js, then the site defaults (_data/site.js). #}
        {% set pageTitle = title | default(site.title) %}
        {% set pageDesc = description | default(esbdMeta.descriptions[page.fileSlug]) | default(site.description) %}
        <title>{{ pageTitle }}</title>
        <meta name="description" content="{{ pageDesc | escape }}" />
        <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

        {# Social cards (Open Graph + Twitter) #}
        <meta property="og:type" content="{% if tags and 'esbd_topic' in tags %}article{% else %}website{% endif %}" />
        <meta property="og:title" content="{{ pageTitle | escape }}" />
        <meta property="og:description" content="{{ pageDesc | escape }}" />
        <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
        <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}" />
        <meta property="og:site_name" content="{{ site.title }}" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="{{ site.twitter }}" />

        <link rel="icon" href="/img/favicon.ico" />

        <link rel="stylesheet" href="/css/style.css" />

        {# Block for additional CSS in child layouts #}
        {% block head_css %}
        {% endblock %}

        {# ?static: disable all CSS animations/transitions before first paint
           (deterministic screenshots; pairs with the JS-side handling in
           ResponsivePlot). #}
        <script>
            // Progressive enhancement: flip no-js -> js before first paint, so
            // JS visitors never see the disabled-control state. Diagram controls
            // are inert until JS wires them up (see .no-js rules in style.css).
            document.documentElement.classList.replace('no-js', 'js');
            if (new URLSearchParams(location.search).has('static'))
                document.documentElement.classList.add('static-render');
        </script>
        {# Block for additional head elements (scripts, meta tags) #}
        {% block head_extra %}
        {% endblock %}
    </head>
    <body>
        <div class="layout-wrapper">
            {# Sidebar: the book's chapter tree (desktop only; on mobile the
               prev/Topics/next bars do the navigating). Order comes from the
               esbd_topic collection (orderESBD); section headings + tier
               break come from _data/esbdMeta.js. #}
            <nav class="site-nav" aria-label="Chapters">
                <a class="site-nav-home" href="/">{{ site.author }}</a>
                <a
                    class="site-nav-book"
                    href="/esbd/"
                    {% if page.url == '/esbd/' %}aria-current="page"{% endif %}
                    >{{ site.title }}</a
                >
                <ul>
                    {%- for topic in collections.esbd_topic %}
                        {%- if topic.url != '/esbd/' %}
                            {%- if topic.fileSlug == esbdMeta.rabbitHolesStart %}
                                <li class="site-nav-tier">The rabbit holes</li>
                            {%- endif %}
                            {%- if esbdMeta.sectionStarts[topic.fileSlug] %}
                                <li class="site-nav-section">{{ esbdMeta.sectionStarts[topic.fileSlug] }}</li>
                            {%- endif %}
                            <li>
                                <a
                                    href="{{ topic.url | url }}"
                                    {% if topic.url == page.url %}aria-current="page"{% endif %}
                                    >{{ topic.data.title }}</a
                                >
                            </li>
                        {%- endif %}
                    {%- endfor %}
                    <li class="site-nav-contents">
                        <a href="/esbd/topics/">Full contents &rarr;</a>
                    </li>
                </ul>
            </nav>

            {# Main content block - child layouts will insert content here #}
            <div class="main-content-area">
                {% block content %}
                    <main>
                        {# Content from individual pages goes here #}
                        {{ content | safe }}
                    </main>
                {% endblock %}
            </div>
        </div>

        <footer>
            <p>
                <small
                    ><a href="/">{{ site.author }}</a> &middot; Made with 11ty,
                    KaTeX, D3, and help from some LLMs.</small
                >
            </p>
        </footer>

        {# Block for JavaScript loaded at the end of the body #}
        {% block footer_scripts %}
        {% endblock %}
    </body>
</html>
